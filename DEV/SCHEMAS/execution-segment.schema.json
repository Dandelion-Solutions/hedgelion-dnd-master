{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/execution-segment.schema.json",
  "title": "HDM embedded committed execution segment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "segment_id", "segment_sequence", "commit_state", "resulting_execution_state", "event_ids",
    "pending_child_invocations", "receipt_exports", "affected_revision_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "segment_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "segment_sequence": {"type": "integer", "minimum": 1},
    "commit_state": {"const": "committed"},
    "resulting_execution_state": {
      "enum": [
        "PENDING", "RUNNING", "AWAITING_CHOICE", "AWAITING_REACTION",
        "HYDRATION_REQUIRED", "PUBLISH_REQUIRED", "COMPLETED", "REJECTED",
        "ABORTED", "FAILED"
      ]
    },
    "event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "pending_child_invocations": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/pending-child-invocation.schema.json"}
    },
    "receipt_exports": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "affected_revision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "continuation_id": {"type": "string", "minLength": 1},
    "accepted_resume_input": {"$ref": "#/$defs/acceptedResumeInput"}
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "boolean"]},
    "acceptedResumeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "resume_fingerprint_generation", "resume_fingerprint", "response_interaction_id", "response_message_id", "target", "selection"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "resume_fingerprint_generation": {"type": "integer", "const": 1},
        "resume_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "response_interaction_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "response_message_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
        "target": {"$ref": "https://hedgelion.invalid/schemas/runtime-interaction-state.schema.json#/$defs/target"},
        "selection": {"$ref": "https://hedgelion.invalid/schemas/runtime-interaction-state.schema.json#/$defs/selection"}
      },
      "allOf": [{"if": {"properties": {"target": {"properties": {"offer_kind": {"const": "choice"}}}}}, "then": {"properties": {"selection": {"properties": {"kind": {"const": "choice"}}}}}, "else": {"properties": {"selection": {"properties": {"kind": {"const": "reaction"}}}}}}]
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "segment_id": "resolution-0000001:segment:1",
      "segment_sequence": 1,
      "commit_state": "committed",
      "resulting_execution_state": "COMPLETED",
      "event_ids": ["event-00000001"],
      "pending_child_invocations": [],
      "receipt_exports": {"hit": true},
      "affected_revision_refs": ["actor-0001@43"]
    }
  ]
}
