{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://hedgelion.invalid/schemas/resolution-receipt.schema.json",
    "title": "HDM execution receipt",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "execution_owner_id",
        "segment_refs",
        "status",
        "event_ids",
        "exports",
        "pending_child_refs"
    ],
    "properties": {
        "execution_owner_id": {
            "type": "string",
            "minLength": 1
        },
        "segment_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "status": {
            "enum": [
                "PENDING",
                "RUNNING",
                "AWAITING_CHOICE",
                "AWAITING_REACTION",
                "HYDRATION_REQUIRED",
                "PUBLISH_REQUIRED",
                "COMPLETED",
                "REJECTED",
                "ABORTED",
                "FAILED"
            ]
        },
        "event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "exports": {
            "type": "object",
            "propertyNames": {
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/scalar"
            }
        },
        "pending_child_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "failure_code": {
            "$ref": "#/$defs/failureCode"
        }
    },
    "allOf": [
        {
            "if": {
                "required": [
                    "failure_code"
                ]
            },
            "then": {
                "properties": {
                    "status": {
                        "enum": [
                            "HYDRATION_REQUIRED",
                            "REJECTED",
                            "ABORTED",
                            "FAILED"
                        ]
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "status": {
                        "enum": [
                            "HYDRATION_REQUIRED",
                            "REJECTED",
                            "FAILED"
                        ]
                    }
                },
                "required": [
                    "status"
                ]
            },
            "then": {
                "required": [
                    "failure_code"
                ]
            }
        }
    ],
    "$defs": {
        "scalar": {
            "type": [
                "string",
                "number",
                "boolean"
            ]
        },
        "failureCode": {
            "enum": [
                "failure.idempotency_conflict",
                "failure.hydration_required",
                "failure.missing_reference",
                "failure.catalog_context_incompatible",
                "failure.continuation_conflict",
                "failure.continuation_stale",
                "failure.dependency_cycle",
                "failure.transition_requires_procedure",
                "failure.order_adjudication_required",
                "failure.execution_limit",
                "failure.state_revision_conflict",
                "failure.invocation_fact_missing",
                "failure.invocation_fact_unauthorized",
                "failure.adjudication_input_missing",
                "failure.adjudication_input_unauthorized",
                "failure.adjudication_input_invalid",
                "failure.adjudication_context_stale",
                "failure.policy_conflict",
                "failure.policy_realization_gap"
            ]
        }
    },
    "examples": [
        {
            "execution_owner_id": "resolution-0000001",
            "segment_refs": [
                "resolution-0000001:segment:1"
            ],
            "status": "COMPLETED",
            "event_ids": [
                "event-00000001"
            ],
            "exports": {
                "hit": true
            },
            "pending_child_refs": []
        }
    ]
}
