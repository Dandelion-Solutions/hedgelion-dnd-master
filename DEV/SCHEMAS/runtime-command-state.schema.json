{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-command-state.schema.json",
  "title": "HDM runtime.command state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "interaction_id", "intent_plan_id", "clause_id", "command_kind",
    "catalog_context_fingerprint", "input_fingerprint", "disposition",
    "invocation_facts", "pending_child_invocations"
  ],
  "properties": {
    "interaction_id": {"type": "string", "minLength": 1},
    "intent_plan_id": {"type": "string", "minLength": 1},
    "clause_id": {"type": "string", "minLength": 1},
    "command_kind": {"enum": ["action", "transition"]},
    "catalog_context_fingerprint": {"type": "string", "minLength": 1},
    "input_fingerprint": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["command.accepted", "command.settled"]},
    "invocation_facts": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/invocation-fact.schema.json"}
    },
    "action_request": {
      "$ref": "https://hedgelion.invalid/schemas/action-request.schema.json"
    },
    "root_resolution_id": {"type": "string", "minLength": 1},
    "transition_request": {
      "$ref": "https://hedgelion.invalid/schemas/transition-request.schema.json"
    },
    "direct_transition_segments": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/execution-segment.schema.json"}
    },
    "pending_child_invocations": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/pending-child-invocation.schema.json"}
    },
    "details": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"command_kind": {"const": "action"}}, "required": ["command_kind"]},
      "then": {
        "required": ["action_request", "root_resolution_id"],
        "not": {
          "anyOf": [
            {"required": ["transition_request"]},
            {"required": ["direct_transition_segments"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"command_kind": {"const": "transition"}}, "required": ["command_kind"]},
      "then": {
        "required": ["transition_request"],
        "not": {
          "anyOf": [
            {"required": ["action_request"]},
            {"required": ["root_resolution_id"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"disposition": {"const": "command.settled"}}, "required": ["disposition"]},
      "then": {
        "properties": {"pending_child_invocations": {"maxItems": 0}}
      }
    },
    {
      "if": {
        "properties": {
          "command_kind": {"const": "transition"},
          "disposition": {"const": "command.settled"}
        },
        "required": ["command_kind", "disposition"]
      },
      "then": {
        "required": ["direct_transition_segments"],
        "properties": {"direct_transition_segments": {"minItems": 1}}
      }
    }
  ],
  "examples": [
    {
      "interaction_id": "turn-000042",
      "intent_plan_id": "turn-000042-plan",
      "clause_id": "c1",
      "command_kind": "action",
      "catalog_context_fingerprint": "sha256:catalog-context-A",
      "input_fingerprint": "sha256:command-input-A",
      "disposition": "command.accepted",
      "invocation_facts": [],
      "action_request": {
        "activity_id": "activity.attack.basic",
        "actor_id": "actor-0001",
        "target_ids": ["actor-0002"]
      },
      "root_resolution_id": "resolution-0000001",
      "pending_child_invocations": []
    }
  ]
}