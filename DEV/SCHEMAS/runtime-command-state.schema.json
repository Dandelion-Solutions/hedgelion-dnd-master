{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-command-state.schema.json",
  "title": "HDM runtime.command state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "command_id", "interaction_id", "intent_plan_id", "clause_id",
    "command_kind", "catalog_context_fingerprint", "input_fingerprint", "disposition",
    "invocation_facts", "pending_child_invocations"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "command_id": {"type": "string", "minLength": 1},
    "interaction_id": {"type": "string", "minLength": 1},
    "intent_plan_id": {"type": "string", "minLength": 1},
    "clause_id": {"type": "string", "minLength": 1},
    "command_kind": {"enum": ["action", "transition"]},
    "catalog_context_fingerprint": {"type": "string", "minLength": 1},
    "input_fingerprint_generation": {"const": 2},
    "input_fingerprint": {"type": "string", "minLength": 1},
    "disposition": {"enum": ["command.accepted", "command.settled"]},
    "invocation_facts": {"type": "array", "items": {"$ref": "https://hedgelion.invalid/schemas/invocation-fact.schema.json"}},
    "action_request": {"$ref": "https://hedgelion.invalid/schemas/action-request.schema.json"},
    "root_resolution_id": {"type": "string", "minLength": 1},
    "transition_request": {"$ref": "https://hedgelion.invalid/schemas/transition-request.schema.json"},
    "direct_transition_segments": {"type": "array", "minItems": 1, "items": {"$ref": "https://hedgelion.invalid/schemas/execution-segment.schema.json"}},
    "direct_transition_receipt": {"$ref": "https://hedgelion.invalid/schemas/resolution-receipt.schema.json"},
    "pending_child_invocations": {"type": "array", "items": {"$ref": "https://hedgelion.invalid/schemas/pending-child-invocation.schema.json"}},
    "interpreter_result": {"$ref": "https://hedgelion.invalid/schemas/interpreter-result.schema.json"},
    "interpreter_result_fingerprint_generation": {"const": 1},
    "interpreter_result_fingerprint": {"$ref": "#/$defs/sha256"},
    "catalog_context": {"$ref": "https://hedgelion.invalid/schemas/catalog-binding-result.schema.json"},
    "candidate_binding": {"$ref": "#/$defs/candidateBinding"},
    "details": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "candidateBinding": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["definition_id", "kind", "source_type", "catalog_generation", "ruleset_set_digest_generation", "ruleset_set_sha256", "catalog_context_fingerprint_generation", "catalog_context_fingerprint", "source_package_id", "source_package_content_sha256"],
          "properties": {
            "definition_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"}, "source_type": {"const": "ruleset_package"}, "catalog_generation": {"const": 2}, "ruleset_set_digest_generation": {"const": 1}, "ruleset_set_sha256": {"$ref": "#/$defs/sha256"}, "catalog_context_fingerprint_generation": {"const": 1}, "catalog_context_fingerprint": {"$ref": "#/$defs/sha256"}, "source_package_id": {"$ref": "#/$defs/id"}, "source_package_content_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["definition_id", "kind", "source_type", "catalog_generation", "ruleset_set_digest_generation", "ruleset_set_sha256", "catalog_context_fingerprint_generation", "catalog_context_fingerprint", "owner_domain", "scope", "route", "pinned_revision", "evidence_sha256"],
          "properties": {
            "definition_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"}, "source_type": {"const": "natural_owner"}, "catalog_generation": {"const": 2}, "ruleset_set_digest_generation": {"const": 1}, "ruleset_set_sha256": {"$ref": "#/$defs/sha256"}, "catalog_context_fingerprint_generation": {"const": 1}, "catalog_context_fingerprint": {"$ref": "#/$defs/sha256"}, "owner_domain": {"enum": ["campaign", "session"]}, "scope": {"enum": ["campaign.definition_frontier", "session.overlay_frontier"]}, "route": {"type": "string", "minLength": 1}, "pinned_revision": {"type": "integer", "minimum": 0}, "evidence_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"command_kind": {"const": "action"}}, "required": ["command_kind"]},
      "then": {"required": ["action_request", "root_resolution_id"], "not": {"anyOf": [{"required": ["transition_request"]}, {"required": ["direct_transition_segments"]}, {"required": ["direct_transition_receipt"]}]}}
    },
    {
      "if": {"properties": {"command_kind": {"const": "action"}}, "required": ["command_kind"]},
      "then": {"required": ["input_fingerprint_generation", "interpreter_result", "interpreter_result_fingerprint_generation", "interpreter_result_fingerprint", "catalog_context", "candidate_binding"]}
    },
    {
      "if": {"properties": {"command_kind": {"const": "transition"}}, "required": ["command_kind"]},
      "then": {"required": ["transition_request"], "not": {"anyOf": [{"required": ["action_request"]}, {"required": ["root_resolution_id"]}]}}
    },
    {
      "if": {"properties": {"disposition": {"const": "command.settled"}}, "required": ["disposition"]},
      "then": {"properties": {"pending_child_invocations": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"command_kind": {"const": "transition"}, "disposition": {"const": "command.settled"}}, "required": ["command_kind", "disposition"]},
      "then": {"required": ["direct_transition_receipt"]}
    },
    {
      "if": {"properties": {"command_kind": {"const": "transition"}, "pending_child_invocations": {"minItems": 1}}, "required": ["command_kind", "pending_child_invocations"]},
      "then": {"required": ["direct_transition_segments", "direct_transition_receipt"]}
    },
    {
      "if": {"properties": {"direct_transition_receipt": {"properties": {"status": {"enum": ["PUBLISH_REQUIRED", "COMPLETED"]}}, "required": ["status"]}}, "required": ["direct_transition_receipt"]},
      "then": {"required": ["direct_transition_segments"]}
    }
  ],
  "examples": []
}
