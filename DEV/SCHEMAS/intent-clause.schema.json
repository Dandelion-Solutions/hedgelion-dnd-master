{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/intent-clause.schema.json",
  "title": "HDM bounded intent clause",
  "type": "object",
  "additionalProperties": false,
  "required": ["clause_id", "order", "mapping_outcome", "execution_state"],
  "properties": {
    "clause_id": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1},
    "mapping_outcome": {
      "enum": ["exact", "composed", "narrative_only", "clarification_required", "unsupported"]
    },
    "execution_state": {
      "enum": ["intent.pending", "intent.ready", "intent.executed", "intent.skipped_due_to_prior_result", "intent.failed"]
    },
    "guard": {"$ref": "#/$defs/guard"},
    "command_id": {"type": "string", "minLength": 1},
    "details": {"type": "object"},
    "collaboration_semantic_class": {
      "enum": [
        "OOC_COORDINATION",
        "DIEGETIC_COMMUNICATION",
        "ACTIONABLE_INTENT",
        "CONTROL_SIGNAL"
      ]
    },
    "normalized_semantics": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": true
    },
    "material_exact_text_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message_id"],
        "properties": {
          "message_id": {"type": "string", "minLength": 1},
          "content_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "coordination_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_owner_kind",
        "native_owner_id",
        "opportunity_id",
        "purpose",
        "dependency_scope",
        "participant_player_ids"
      ],
      "properties": {
        "native_owner_kind": {"type": "string", "minLength": 1},
        "native_owner_id": {"type": "string", "minLength": 1},
        "opportunity_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "dependency_scope": {"type": "string", "minLength": 1},
        "participant_player_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["collaboration_semantic_class"]},
      "then": {"required": ["normalized_semantics"]}
    },
    {
      "if": {"required": ["normalized_semantics"]},
      "then": {"required": ["collaboration_semantic_class"]}
    },
    {
      "if": {"required": ["coordination_candidate"]},
      "then": {"required": ["collaboration_semantic_class", "normalized_semantics"]}
    }
  ],
  "$defs": {
    "scalar": {"type": ["string", "number", "boolean"]},
    "guard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior_clause_id", "source", "operator", "literal"],
          "properties": {
            "prior_clause_id": {"type": "string", "minLength": 1},
            "source": {"const": "status"},
            "operator": {"const": "eq"},
            "literal": {"$ref": "#/$defs/scalar"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior_clause_id", "source", "export_id", "operator", "literal"],
          "properties": {
            "prior_clause_id": {"type": "string", "minLength": 1},
            "source": {"const": "export"},
            "export_id": {"type": "string", "minLength": 1},
            "operator": {"const": "eq"},
            "literal": {"$ref": "#/$defs/scalar"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior_clause_id", "source", "export_id", "operator", "literal_values"],
          "properties": {
            "prior_clause_id": {"type": "string", "minLength": 1},
            "source": {"const": "export"},
            "export_id": {"type": "string", "minLength": 1},
            "operator": {"const": "in"},
            "literal_values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}}
          }
        }
      ]
    }
  },
  "examples": [
    {
      "clause_id": "clause-02",
      "order": 2,
      "mapping_outcome": "exact",
      "execution_state": "intent.ready",
      "guard": {
        "prior_clause_id": "clause-01",
        "source": "status",
        "operator": "eq",
        "literal": "intent.executed"
      }
    }
  ]
}
