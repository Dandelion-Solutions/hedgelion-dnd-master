{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/intent-clause.schema.json",
  "title": "HDM bounded intent clause",
  "type": "object",
  "additionalProperties": false,
  "required": ["clause_id", "order", "mapping_outcome", "execution_state"],
  "properties": {
    "clause_id": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1},
    "mapping_outcome": {
      "enum": ["exact", "composed", "narrative_only", "clarification_required", "unsupported"]
    },
    "execution_state": {
      "enum": ["intent.pending", "intent.ready", "intent.executed", "intent.skipped_due_to_prior_result", "intent.failed"]
    },
    "guard": {"$ref": "#/$defs/guard"},
    "command_id": {"type": "string", "minLength": 1},
    "details": {"type": "object"},
    "collaboration_semantic_class": {
      "enum": ["OOC_COORDINATION", "DIEGETIC_COMMUNICATION", "ACTIONABLE_INTENT", "CONTROL_SIGNAL"]
    },
    "normalized_semantics": {"type": "object", "minProperties": 1},
    "material_exact_text_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_kind": {
      "enum": [
        "JOINT_VOLUNTARY_ACTION",
        "SHARED_DECISION_OR_NEGOTIATION",
        "SHARED_SCARCE_RESOURCE_CHOICE",
        "SCENE_CHRONOLOGY_CONVERGENCE",
        "PC_CONSEQUENCE_DECISION"
      ]
    },
    "purpose": {"type": "string", "minLength": 1},
    "dependency_scope": {"type": "object", "minProperties": 1},
    "required_contributors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contributor"}
    },
    "native_basis_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nativeBasisRef"}
    },
    "ordering_resolution_id": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "boolean"]},
    "guard": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior_clause_id", "source", "operator", "literal"],
          "properties": {
            "prior_clause_id": {"type": "string", "minLength": 1},
            "source": {"const": "status"},
            "operator": {"const": "eq"},
            "literal": {"$ref": "#/$defs/scalar"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior_clause_id", "source", "export_id", "operator", "literal"],
          "properties": {
            "prior_clause_id": {"type": "string", "minLength": 1},
            "source": {"const": "export"},
            "export_id": {"type": "string", "minLength": 1},
            "operator": {"const": "eq"},
            "literal": {"$ref": "#/$defs/scalar"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prior_clause_id", "source", "export_id", "operator", "literal_values"],
          "properties": {
            "prior_clause_id": {"type": "string", "minLength": 1},
            "source": {"const": "export"},
            "export_id": {"type": "string", "minLength": 1},
            "operator": {"const": "in"},
            "literal_values": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}}
          }
        }
      ]
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_id"],
      "properties": {
        "player_id": {"type": "string", "minLength": 1},
        "pc_id": {"type": "string", "minLength": 1}
      }
    },
    "nativeBasisRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "id"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1}
      }
    }
  },
  "examples": [
    {
      "clause_id": "clause-02",
      "order": 2,
      "mapping_outcome": "exact",
      "execution_state": "intent.ready",
      "guard": {
        "prior_clause_id": "clause-01",
        "source": "status",
        "operator": "eq",
        "literal": "intent.executed"
      }
    }
  ]
}
