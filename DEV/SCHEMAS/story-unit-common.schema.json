{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/story-unit-common.schema.json",
  "title": "HDM StoryUnit common envelope definitions",
  "$defs": {
    "storyRef": {
      "type": "string",
      "pattern": "^[TEMN](?:0{5}[1-9]|0{4}[1-9][0-9]|0{3}[1-9][0-9]{2}|0{2}[1-9][0-9]{3}|0[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6,})$"
    },
    "transcriptStoryRef": {
      "type": "string",
      "pattern": "^T(?:0{5}[1-9]|0{4}[1-9][0-9]|0{3}[1-9][0-9]{2}|0{2}[1-9][0-9]{3}|0[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6,})$"
    },
    "eventStoryRef": {
      "type": "string",
      "pattern": "^E(?:0{5}[1-9]|0{4}[1-9][0-9]|0{3}[1-9][0-9]{2}|0{2}[1-9][0-9]{3}|0[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6,})$"
    },
    "mechanicsStoryRef": {
      "type": "string",
      "pattern": "^M(?:0{5}[1-9]|0{4}[1-9][0-9]|0{3}[1-9][0-9]{2}|0{2}[1-9][0-9]{3}|0[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6,})$"
    },
    "narrativeStoryRef": {
      "type": "string",
      "pattern": "^N(?:0{5}[1-9]|0{4}[1-9][0-9]|0{3}[1-9][0-9]{2}|0{2}[1-9][0-9]{3}|0[1-9][0-9]{4}|[1-9][0-9]{5}|[1-9][0-9]{6,})$"
    },
    "localKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "nativeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "identity"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "identity": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "selector": {}
      }
    },
    "sourceDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"$ref": "#/$defs/nativeRef"},
        "basis": {}
      }
    },
    "projectionContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_domain",
        "semantic_contract_generation",
        "candidate_ids"
      ],
      "properties": {
        "source_domain": {"type": "string", "minLength": 1},
        "semantic_contract_generation": {"type": "integer", "minimum": 1},
        "candidate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_story_refs"],
      "properties": {
        "requires_story_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/storyRef"}
        },
        "requires_source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nativeRef"}
        }
      }
    },
    "storyUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "story_id",
        "content",
        "sources",
        "projection_basis",
        "availability",
        "payload"
      ],
      "properties": {
        "schema_version": {"type": "integer", "minimum": 1},
        "story_id": {"$ref": "#/$defs/storyRef"},
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body"],
          "properties": {
            "body": {"type": "string", "minLength": 1},
            "title": {"type": "string", "minLength": 1}
          }
        },
        "sources": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"$ref": "#/$defs/localKey"},
          "additionalProperties": {"$ref": "#/$defs/sourceDependency"}
        },
        "projection_basis": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/projectionContribution"}
        },
        "entity_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nativeRef"}
        },
        "cross_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/storyRef"}
        },
        "temporal_source_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localKey"}
        },
        "causal_source_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/localKey"}
        },
        "availability": {"$ref": "#/$defs/availability"},
        "payload": {"type": "object"}
      }
    }
  }
}
