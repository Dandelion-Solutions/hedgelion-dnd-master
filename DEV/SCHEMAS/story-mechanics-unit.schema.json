{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/story-mechanics-unit.schema.json",
  "title": "HDM Story MECHANICS unit",
  "$defs": {
    "mechanicalSegmentOwnerRef": {
      "allOf": [
        {
          "$ref": "story-unit-common.schema.json#/$defs/nativeRef"
        },
        {
          "type": "object",
          "required": ["selector"],
          "properties": {
            "family": {
              "enum": ["runtime.resolution", "runtime.command"]
            },
            "identity": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1
            },
            "selector": {
              "type": "object",
              "additionalProperties": false,
              "required": ["segment_id", "segment_sequence"],
              "properties": {
                "segment_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*:segment:[1-9][0-9]*$"
                },
                "segment_sequence": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {"$ref": "story-unit-common.schema.json#/$defs/storyUnit"},
    {
      "type": "object",
      "required": ["payload"],
      "properties": {
        "schema_version": {"const": 4},
        "story_id": {
          "$ref": "story-unit-common.schema.json#/$defs/mechanicsStoryRef"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanical_source_keys"],
          "properties": {
            "mechanical_source_keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "story-unit-common.schema.json#/$defs/localKey"}
            },
            "resolution_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "story-unit-common.schema.json#/$defs/nativeRef"}
            },
            "receipt_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "story-unit-common.schema.json#/$defs/nativeRef"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["projection_basis"],
        "properties": {
          "projection_basis": {
            "type": "array",
            "contains": {
              "type": "object",
              "required": ["source_domain"],
              "properties": {
                "source_domain": {
                  "pattern": "^campaign\\.mechanical_segments@"
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "anyOf": [
              {
                "required": ["resolution_refs"],
                "properties": {
                  "resolution_refs": {
                    "minItems": 1,
                    "contains": {"$ref": "#/$defs/mechanicalSegmentOwnerRef"}
                  }
                }
              },
              {
                "required": ["receipt_refs"],
                "properties": {
                  "receipt_refs": {
                    "minItems": 1,
                    "contains": {"$ref": "#/$defs/mechanicalSegmentOwnerRef"}
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
