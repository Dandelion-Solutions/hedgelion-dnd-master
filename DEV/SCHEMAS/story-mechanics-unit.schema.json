{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/story-mechanics-unit.schema.json",
  "title": "HDM Story MECHANICS unit",
  "allOf": [
    {"$ref": "story-unit-common.schema.json#/$defs/storyUnit"},
    {
      "type": "object",
      "required": ["payload"],
      "properties": {
        "schema_version": {"const": 2},
        "story_id": {"pattern": "^M[0-9]{6,}$"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mechanical_source_keys"],
          "properties": {
            "mechanical_source_keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "story-unit-common.schema.json#/$defs/localKey"}
            },
            "resolution_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "story-unit-common.schema.json#/$defs/nativeRef"}
            },
            "receipt_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "story-unit-common.schema.json#/$defs/nativeRef"}
            }
          }
        }
      }
    }
  ]
}
