{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/continuity-projection-candidate.schema.json",
  "title": "HDM derived continuity projection candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor_id", "expected_state_revision", "source_refs", "projection_kind", "continuity"],
  "properties": {
    "actor_id": {"$ref": "#/$defs/id"},
    "expected_state_revision": {"type": "integer", "minimum": 0},
    "source_refs": {"$ref": "#/$defs/idSet"},
    "projection_kind": {"const": "continuity.derived"},
    "continuity": {"$ref": "#/$defs/continuity"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "continuity": {"$ref": "world-actor-state.schema.json#/$defs/continuity"}
  }
}
