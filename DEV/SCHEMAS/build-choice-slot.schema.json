{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/build-choice-slot.schema.json",
  "title": "HDM stable character-build choice slot",
  "type": "object",
  "additionalProperties": false,
  "required": ["choice_id", "minimum", "maximum", "options"],
  "properties": {
    "choice_id": {"$ref": "#/$defs/machineId"},
    "minimum": {"type": "integer", "minimum": 0},
    "maximum": {"type": "integer", "minimum": 1},
    "default_option_ids": {"$ref": "#/$defs/idSet"},
    "decision_policy": {
      "enum": ["choice.player_required", "choice.player_or_delegated", "choice.deterministic_default"]
    },
    "options": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/option"}
    }
  },
  "allOf": [
    {
      "if": {"required": ["minimum", "maximum"]},
      "then": {
        "description": "Catalog compilation additionally enforces minimum <= maximum, unique option_id values, default cardinality and default membership."
      }
    }
  ],
  "$defs": {
    "machineId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/machineId"}
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "scalar": {"type": ["string", "number", "boolean"]},
    "assetGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/machineId"},
        "quantity": {"type": "integer", "minimum": 1}
      }
    },
    "spellBindings": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "known_spell_ids": {"$ref": "#/$defs/idSet"},
        "prepared_spell_ids": {"$ref": "#/$defs/idSet"},
        "spellbook_spell_ids": {"$ref": "#/$defs/idSet"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id"],
      "properties": {
        "option_id": {"$ref": "#/$defs/machineId"},
        "name": {"$ref": "#/$defs/localizedText"},
        "grant_definition_ids": {"$ref": "#/$defs/idSet"},
        "ability_adjustments": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/machineId"},
          "additionalProperties": {"type": "integer"}
        },
        "spell_bindings": {"$ref": "#/$defs/spellBindings"},
        "starting_assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/assetGrant"}
        },
        "build_parameters": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/machineId"},
          "additionalProperties": {"$ref": "#/$defs/scalar"}
        }
      },
      "anyOf": [
        {"required": ["grant_definition_ids"]},
        {"required": ["ability_adjustments"]},
        {"required": ["spell_bindings"]},
        {"required": ["starting_assets"]},
        {"required": ["build_parameters"]}
      ]
    }
  },
  "examples": [
    {
      "choice_id": "advancement.fighter.level_1.style",
      "minimum": 1,
      "maximum": 1,
      "decision_policy": "choice.player_or_delegated",
      "options": [
        {"option_id": "choice.fighting_style.defense", "grant_definition_ids": ["feature.fighting_style.defense"]},
        {"option_id": "choice.fighting_style.archery", "grant_definition_ids": ["feature.fighting_style.archery"]}
      ]
    }
  ]
}
