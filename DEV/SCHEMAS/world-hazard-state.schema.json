{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/world-hazard-state.schema.json",
  "title": "HDM world.hazard state",
  "type": "object",
  "additionalProperties": false,
  "required": ["status"],
  "properties": {
    "status": {"type": "object"},
    "location_id": {"$ref": "#/$defs/id"},
    "zone_id": {"$ref": "#/$defs/id"},
    "detected_by_actor_ids": {"$ref": "#/$defs/idSet"},
    "effect_ids": {"$ref": "#/$defs/idSet"},
    "details": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
