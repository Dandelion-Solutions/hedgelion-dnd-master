{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-continuation-state.schema.json",
  "title": "HDM runtime.continuation state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation", "root_command_id", "resolution_id", "activity_id", "actor_id",
    "catalog_context_fingerprint", "execution_cursor", "safe_recompute_phase",
    "invocation_facts", "fixed_rng_results", "prior_step_exports",
    "committed_segment_refs", "dependency_frontier_refs",
    "expected_child_resolution_ids", "future_rng_frontier"
  ],
  "properties": {
    "generation": {"type": "integer", "minimum": 1},
    "root_command_id": {"type": "string", "minLength": 1},
    "resolution_id": {"type": "string", "minLength": 1},
    "activity_id": {"$ref": "#/$defs/id"},
    "actor_id": {"$ref": "#/$defs/id"},
    "source_id": {"$ref": "#/$defs/id"},
    "target_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "parameter_bindings": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "https://hedgelion.invalid/schemas/activity-parameter-binding.schema.json"}
    },
    "catalog_context_fingerprint": {"type": "string", "minLength": 1},
    "procedure_id": {"type": "string", "minLength": 1},
    "execution_cursor": {"type": "string", "minLength": 1},
    "safe_recompute_phase": {"type": "string", "minLength": 1},
    "invocation_facts": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/invocation-fact.schema.json"}
    },
    "fixed_rng_results": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/roll-result.schema.json"}
    },
    "prior_step_exports": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "committed_segment_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_frontier_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_child_resolution_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "future_rng_frontier": {"type": "string", "minLength": 1},
    "pending_response": {
      "oneOf": [
        {"$ref": "https://hedgelion.invalid/schemas/choice-request.schema.json"},
        {"$ref": "https://hedgelion.invalid/schemas/reaction-offer.schema.json"}
      ]
    },
    "unconsumed_advancement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "unit_id", "context_id"],
      "properties": {
        "amount": {"type": "integer", "minimum": 1},
        "unit_id": {"enum": ["unit.second", "unit.minute", "unit.hour", "unit.day"]},
        "context_id": {"type": "string", "minLength": 1}
      }
    },
    "details": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "scalar": {"type": ["string", "number", "boolean"]}
  },
  "description": "A suspended Resolution preserves accepted parameter bindings exactly as causal inputs. INVOCATION_ADJUDICATED bindings therefore retain provenance, decision-eligibility basis, current rules-context basis and applicable policy references across suspension/resume; later policy publication does not rewrite this stored accepted binding.",
  "examples": [
    {
      "generation": 1,
      "root_command_id": "turn-000042-cmd-01",
      "resolution_id": "resolution-0000001",
      "activity_id": "activity.attack.basic",
      "actor_id": "actor-0001",
      "target_ids": ["actor-0002"],
      "catalog_context_fingerprint": "ctx",
      "execution_cursor": "step.attack.resolve",
      "safe_recompute_phase": "determine",
      "invocation_facts": [],
      "fixed_rng_results": [
        {"roll_id": "roll.attack.1", "request_id": "roll.attack.1", "expression": "1d20", "raw_values": [17], "source_kind": "rng.system", "provenance_ref": "rng:42:1"}
      ],
      "prior_step_exports": {"attack_roll": 17},
      "committed_segment_refs": ["resolution-0000001:segment:1"],
      "dependency_frontier_refs": ["actor-0001@12"],
      "expected_child_resolution_ids": [],
      "future_rng_frontier": "rng:42"
    }
  ]
}
