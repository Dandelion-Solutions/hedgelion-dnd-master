{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-continuation-state.schema.json",
  "title": "HDM runtime.continuation state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "generation", "root_command_id", "resolution_id",
    "catalog_context_fingerprint", "safe_recompute_phase", "invocation_facts",
    "fixed_rng_results", "prior_step_exports", "committed_receipt_refs",
    "dependency_frontier_refs", "expected_child_resolution_ids",
    "future_rng_frontier"
  ],
  "properties": {
    "generation": {"type": "integer", "minimum": 1},
    "root_command_id": {"type": "string", "minLength": 1},
    "resolution_id": {"type": "string", "minLength": 1},
    "catalog_context_fingerprint": {"type": "string", "minLength": 1},
    "procedure_id": {"type": "string", "minLength": 1},
    "safe_recompute_phase": {"type": "string", "minLength": 1},
    "invocation_facts": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/invocation-fact.schema.json"}
    },
    "fixed_rng_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/scalar"}
    },
    "prior_step_exports": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/scalar"}
    },
    "committed_receipt_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "dependency_frontier_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "expected_child_resolution_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "future_rng_frontier": {"type": "string", "minLength": 1},
    "pending_response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offer_id", "responder_id", "candidate_activity_ids"],
          "properties": {
            "kind": {"const": "reaction"},
            "offer_id": {"type": "string", "minLength": 1},
            "responder_id": {"type": "string", "minLength": 1},
            "candidate_activity_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offer_id", "responder_id", "option_ids"],
          "properties": {
            "kind": {"const": "choice"},
            "offer_id": {"type": "string", "minLength": 1},
            "responder_id": {"type": "string", "minLength": 1},
            "option_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      ]
    },
    "unconsumed_advancement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "unit_id", "context_id"],
      "properties": {
        "amount": {"type": "integer", "minimum": 1},
        "unit_id": {"enum": ["unit.second", "unit.minute", "unit.hour", "unit.day"]},
        "context_id": {"type": "string", "minLength": 1}
      }
    },
    "details": {"type": "object"}
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "boolean"]}
  },
  "examples": [
    {
      "generation": 1,
      "root_command_id": "turn-000042-cmd-01",
      "resolution_id": "resolution-0000001",
      "catalog_context_fingerprint": "ctx",
      "safe_recompute_phase": "determine",
      "invocation_facts": [],
      "fixed_rng_results": [17],
      "prior_step_exports": {"attack_roll": 17},
      "committed_receipt_refs": ["resolution-0000001:segment:1"],
      "dependency_frontier_refs": ["actor-0001@12"],
      "expected_child_resolution_ids": [],
      "future_rng_frontier": "rng:42"
    }
  ]
}
