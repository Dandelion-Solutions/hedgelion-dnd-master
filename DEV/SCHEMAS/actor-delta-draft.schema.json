{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/actor-delta-draft.schema.json",
  "title": "HDM actor continuity delta draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["actor_id", "expected_state_revision", "purpose", "source_refs", "changes"],
  "properties": {
    "actor_id": {"$ref": "#/$defs/id"},
    "expected_state_revision": {"type": "integer", "minimum": 0},
    "purpose": {"enum": ["assessment.react", "assessment.reflect", "assessment.plan", "assessment.reconsider", "assessment.relationship_update"]},
    "source_refs": {"$ref": "#/$defs/idSet"},
    "foundation_transition": {"const": "foundation.explicit"},
    "changes": {"$ref": "#/$defs/changes"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "continuity": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"foundation": {"type": "object", "minProperties": 1}, "evolving": {"type": "object", "minProperties": 1}, "relationships": {"type": "object", "minProperties": 1}}},
    "changes": {"type": "object", "additionalProperties": false, "required": ["continuity"], "properties": {"continuity": {"$ref": "#/$defs/continuity"}}}
  },
  "allOf": [{"if": {"properties": {"changes": {"properties": {"continuity": {"required": ["foundation"]}}}}, "required": ["changes"]}, "then": {"required": ["foundation_transition"]}}]
}
