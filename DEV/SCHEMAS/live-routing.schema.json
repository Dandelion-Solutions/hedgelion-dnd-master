{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/live-routing.schema.json",
  "title": "HDM bounded selected LIVE routing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "campaign_id", "complete", "entries"],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "runtime.live_routing"},
    "campaign_id": {"type": ["string", "null"], "minLength": 1},
    "complete": {"const": true},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campaign_id",
          "scene_id",
          "epoch_id",
          "source_ref",
          "source_revision",
          "status",
          "claims"
        ],
        "properties": {
          "campaign_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
          "scene_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
          "epoch_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
          "source_ref": {"type": "string", "minLength": 1},
          "source_revision": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}(?:[a-f0-9]{24})?|[A-Za-z][A-Za-z0-9_.:-]*)$"
          },
          "status": {"enum": ["ACTIVE", "CLOSED", "CLOSED_UNABSORBED", "ABSORBED"]},
          "claims": {
            "type": "array",
            "items": {"$ref": "live-claim.schema.json"}
          }
        }
      }
    }
  }
}
