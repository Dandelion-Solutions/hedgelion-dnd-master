{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/live-routing.schema.json",
  "title": "HDM bounded selected LIVE routing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "campaign_id", "complete", "entries"],
  "properties": {
    "schema_version": {"const": 4},
    "kind": {"const": "runtime.live_routing"},
    "campaign_id": {"type": ["string", "null"], "minLength": 1},
    "complete": {"const": true},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campaign_id",
          "scene_id",
          "epoch_id",
          "source_ref",
          "source_revision",
          "opening_campaign_revision",
          "status",
          "claims",
          "next_source_native_creation_ordinal",
          "source_native_ids"
        ],
        "properties": {
          "campaign_id": {"type": "string", "minLength": 1},
          "scene_id": {"type": "string", "minLength": 1},
          "epoch_id": {"type": "string", "pattern": "^e1-[0-9a-f]{64}$"},
          "source_ref": {
            "type": "string",
            "pattern": "^live/c1-[0-9a-f]{64}/s1-[0-9a-f]{64}/e1-[0-9a-f]{64}/LIVE/LIVE_STATE\\.yaml$"
          },
          "source_revision": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}(?:[a-f0-9]{24})?|[A-Za-z][A-Za-z0-9_.:-]*)$"
          },
          "opening_campaign_revision": {
            "type": "string",
            "pattern": "^(?:[a-f0-9]{40}(?:[a-f0-9]{24})?|[A-Za-z][A-Za-z0-9_.:-]*)$"
          },
          "status": {"enum": ["ACTIVE", "CLOSED", "CLOSED_UNABSORBED", "ABSORBED"]},
          "claims": {
            "type": "array",
            "items": {"$ref": "live-claim.schema.json"}
          },
          "next_source_native_creation_ordinal": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "source_native_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*:live1:[a-z0-9]+$"
            }
          }
        }
      }
    }
  }
}
