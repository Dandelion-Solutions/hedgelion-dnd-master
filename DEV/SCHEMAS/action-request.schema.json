{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/action-request.schema.json",
  "title": "HDM ActionRequest value",
  "type": "object",
  "additionalProperties": false,
  "required": ["activity_id", "actor_id"],
  "properties": {
    "activity_id": {"$ref": "#/$defs/id"},
    "actor_id": {"$ref": "#/$defs/id"},
    "source_id": {"$ref": "#/$defs/id"},
    "target_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "parameter_bindings": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "https://hedgelion.invalid/schemas/activity-parameter-binding.schema.json"}
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}
  },
  "description": "The deterministic binder validates each parameter binding against the selected Activity parameter declaration. INVOCATION_ADJUDICATED parameters require the enriched binding object from activity-parameter-binding.schema.json; raw scalars/arrays are not sufficient evidence for that source class. PLAYER_CHOICE and ENGINE_BOUND semantics remain declaration-owned and cannot be relabeled as adjudicated input by the request.",
  "examples": [
    {
      "activity_id": "srd.activity.longsword_attack",
      "actor_id": "actor-0001",
      "source_id": "asset-00001",
      "target_ids": ["actor-0014"]
    },
    {
      "activity_id": "activity.test.generic",
      "actor_id": "actor-0001",
      "parameter_bindings": {
        "dc": {
          "source_class": "INVOCATION_ADJUDICATED",
          "value": 15,
          "provenance_ref": "interaction-000001:adjudication:dc",
          "eligibility_basis_fingerprint": "sha256:eligibility-A",
          "rules_context_fingerprint": "sha256:rules-A",
          "policy_basis_refs": []
        }
      }
    }
  ]
}
