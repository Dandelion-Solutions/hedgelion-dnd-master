{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/collaboration-frontier.schema.json",
  "title": "HDM runtime.collaboration_frontier state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "obligation_id",
    "generation",
    "campaign_id",
    "dependency_scope",
    "safe_prefix_refs",
    "pending_required_contributors"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "runtime.collaboration_frontier"},
    "obligation_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1},
    "campaign_id": {"$ref": "#/$defs/id"},
    "dependency_scope": {"type": "object", "minProperties": 1},
    "safe_prefix_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/currentBasisRef"}
    },
    "pending_required_contributors": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contributor"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "currentBasisRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "id", "revision"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "id": {"$ref": "#/$defs/id"},
        "revision": {"type": "string", "minLength": 1}
      }
    },
    "contributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_id"],
      "properties": {
        "player_id": {"$ref": "#/$defs/id"},
        "pc_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
