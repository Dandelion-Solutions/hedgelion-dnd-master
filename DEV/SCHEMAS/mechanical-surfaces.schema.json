{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/mechanical-surfaces.schema.json",
  "title": "HDM reviewed mechanical selector/accessor/input metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_version",
    "context_facts",
    "accessors",
    "selectors",
    "derived_nodes"
  ],
  "properties": {
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "context_facts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/machineId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/contextFactMetadata"
      }
    },
    "accessors": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/machineId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/accessorMetadata"
      }
    },
    "selectors": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/machineId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/selectorMetadata"
      }
    },
    "derived_nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "enum": [
          "effect_availability",
          "effect_arbitration",
          "condition_aggregation",
          "condition_intrinsic"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/derivedNodeMetadata"
      }
    }
  },
  "$defs": {
    "machineId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/machineId"
      }
    },
    "dependencyRef": {
      "type": "string",
      "pattern": "^(?:selector|accessor|derived):[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "dependencyKindSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "selector",
          "accessor",
          "derived"
        ]
      }
    },
    "inputClassSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ENGINE_STATE",
          "INVOCATION_ADJUDICATED"
        ]
      }
    },
    "contextFactMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "value_type"
      ],
      "properties": {
        "source_class": {
          "const": "INVOCATION_ADJUDICATED"
        },
        "value_type": {
          "const": "boolean"
        }
      }
    },
    "accessorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "value_type",
        "subject_kinds",
        "dependencies"
      ],
      "properties": {
        "source_class": {
          "enum": [
            "DIRECT_AUTHORITY",
            "DERIVED_MECHANICAL"
          ]
        },
        "value_type": {
          "enum": [
            "boolean",
            "integer",
            "number",
            "machine_id",
            "scalar"
          ]
        },
        "subject_kinds": {
          "$ref": "#/$defs/idSet"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependencyRef"
          }
        }
      }
    },
    "selectorMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_operations",
        "operation_contracts",
        "contribution_type",
        "result_type",
        "result_constraints",
        "subject_kinds",
        "binding_kinds",
        "allowed_dependency_kinds",
        "allowed_input_classes",
        "permitted_context_fact_ids",
        "static_dependencies",
        "combination_policy",
        "resolution_owner",
        "trace_policy"
      ],
      "properties": {
        "allowed_operations": {
          "$ref": "#/$defs/idSet"
        },
        "operation_contracts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/machineId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/operationContract"
          }
        },
        "contribution_type": {
          "enum": [
            "numeric",
            "applicability"
          ]
        },
        "result_type": {
          "enum": [
            "integer",
            "boolean"
          ]
        },
        "result_constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "integer"
            }
          }
        },
        "subject_kinds": {
          "$ref": "#/$defs/idSet"
        },
        "binding_kinds": {
          "type": "array",
          "items": {
            "enum": [
              "subject",
              "condition_definition",
              "resource_definition"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_dependency_kinds": {
          "$ref": "#/$defs/dependencyKindSet"
        },
        "allowed_input_classes": {
          "$ref": "#/$defs/inputClassSet"
        },
        "permitted_context_fact_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/machineId"
          },
          "uniqueItems": true
        },
        "static_dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependencyRef"
          },
          "uniqueItems": true
        },
        "combination_policy": {
          "enum": [
            "integer_additive_v1",
            "immunity_any_true_v1"
          ]
        },
        "resolution_owner": {
          "const": "SELECTOR_METADATA"
        },
        "trace_policy": {
          "const": "RETAIN_ACCEPTED_REJECTED_PROVENANCE"
        }
      }
    },
    "derivedNodeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_dependency_kinds",
        "allowed_input_classes",
        "dependencies"
      ],
      "properties": {
        "allowed_dependency_kinds": {
          "$ref": "#/$defs/dependencyKindSet"
        },
        "allowed_input_classes": {
          "$ref": "#/$defs/inputClassSet"
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/dependencyRef"
          }
        }
      }
    },
    "operationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_kind",
        "normalization",
        "constraints"
      ],
      "properties": {
        "value_kind": {
          "enum": [
            "numeric_scalar",
            "boolean_constant"
          ]
        },
        "normalization": {
          "enum": [
            "SUM",
            "ANY_TRUE"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "enum": [
              "finite_integer",
              "literal_true"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "fixed_value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        }
      }
    }
  }
}
