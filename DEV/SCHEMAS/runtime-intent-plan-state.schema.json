{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-intent-plan-state.schema.json",
  "title": "HDM runtime.intent_plan state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interaction_id", "clauses"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "interaction_id": {"$ref": "https://hedgelion.invalid/schemas/runtime-interaction-state.schema.json#/$defs/id"},
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://hedgelion.invalid/schemas/intent-clause.schema.json"}
    },
    "details": {"type": "object"}
  },
  "examples": [
    {
      "schema_version": 1,
      "interaction_id": "turn-000042",
      "clauses": [
        {"schema_version": 1, "clause_kind": "intent", "clause_id": "c1", "order": 1, "mapping_outcome": "exact", "execution_state": "intent.executed"},
        {"schema_version": 1, "clause_kind": "intent", "clause_id": "c2", "order": 2, "mapping_outcome": "exact", "execution_state": "intent.failed"}
      ]
    }
  ]
}
