{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/native-owner-hot-envelope.schema.json",
  "title": "HDM local native owner HOT envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "family_key", "identity", "payload", "source_basis", "generation"],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1},
    "family_key": {"type": "string", "pattern": "^(world|runtime)\\.[a-z][a-z0-9_]*$"},
    "identity": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "payload": {"type": "object"},
    "source_basis": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 0}
  }
}
