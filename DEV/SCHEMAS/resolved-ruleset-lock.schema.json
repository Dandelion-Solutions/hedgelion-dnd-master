{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/resolved-ruleset-lock.schema.json",
  "title": "HDM ResolvedRulesetSnapshotSet evidence",
  "type": "object", "additionalProperties": false,
  "required": ["lock_schema_version", "ruleset_set_digest_generation", "root_package_ids", "packages", "ruleset_set_sha256"],
  "properties": {
    "lock_schema_version": {"const": 2},
    "ruleset_set_digest_generation": {"const": 1},
    "root_package_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/package"}},
    "ruleset_set_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "member": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["package_id", "content_sha256"], "properties": {"package_id": {"$ref": "#/$defs/id"}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["package_id", "package_revision", "compatibility_family", "compatibility_generation", "content_sha256", "catalog_generation", "owned_namespaces", "dependencies", "members"],
      "properties": {
        "package_id": {"$ref": "#/$defs/id"},
        "package_revision": {"type": "integer", "minimum": 1},
        "compatibility_family": {"$ref": "#/$defs/id"},
        "compatibility_generation": {"type": "integer", "minimum": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_generation": {"type": "integer", "minimum": 1},
        "owned_namespaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.\\*$"}},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/dependency"}},
        "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}}
      }
    }
  }
}
