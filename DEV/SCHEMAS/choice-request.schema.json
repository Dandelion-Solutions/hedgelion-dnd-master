{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/choice-request.schema.json",
  "title": "HDM value.choice_request",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "offer_id", "responder_id", "option_ids"],
  "properties": {
    "kind": {"const": "choice"},
    "offer_id": {"type": "string", "minLength": 1},
    "responder_id": {"type": "string", "minLength": 1},
    "option_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "examples": [
    {
      "kind": "choice",
      "offer_id": "choice-0001",
      "responder_id": "actor-0001",
      "option_ids": ["option.left", "option.right"]
    }
  ]
}