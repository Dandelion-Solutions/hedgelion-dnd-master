{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/activity-definition-data.schema.json",
  "title": "HDM definition.activity data",
  "type": "object",
  "additionalProperties": false,
  "required": ["family_id", "steps"],
  "properties": {
    "family_id": {"$ref": "#/$defs/machineId"},
    "activation": {"$ref": "#/$defs/activation"},
    "parameters": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/resultName"},
      "additionalProperties": {"$ref": "https://hedgelion.invalid/schemas/activity-parameter-spec.schema.json"}
    },
    "requirements": {"$ref": "https://hedgelion.invalid/schemas/mechanical-predicate.schema.json"},
    "targeting": {"$ref": "https://hedgelion.invalid/schemas/target-spec.schema.json"},
    "costs": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/cost-spec.schema.json"}
    },
    "duration": {"$ref": "https://hedgelion.invalid/schemas/duration-spec.schema.json"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "details": {"type": "object"}
  },
  "$defs": {
    "machineId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "resultName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "economy_id": {"$ref": "#/$defs/machineId"},
        "amount": {"type": "integer", "minimum": 0}
      }
    },
    "resultCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "in"],
      "properties": {
        "result": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": ["string", "number", "integer", "boolean"]}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {"type": "string", "pattern": "^op\\.[a-z][a-z0-9_]*$"},
        "args": {
          "type": "object",
          "description": "Validated against the exact registered operation contract selected by op."
        },
        "when": {
          "oneOf": [
            {"$ref": "#/$defs/resultCondition"},
            {"$ref": "https://hedgelion.invalid/schemas/mechanical-predicate.schema.json"}
          ]
        },
        "export": {"$ref": "#/$defs/resultName"}
      }
    }
  },
  "examples": [
    {
      "family_id": "activity.attack",
      "targeting": {
        "kind_id": "target.entity",
        "minimum": 1,
        "maximum": 1,
        "range": {"mode_id": "range.reachable"}
      },
      "steps": [
        {"op": "op.resolve_attack", "export": "attack"},
        {"op": "op.apply_damage", "when": {"result": "attack.outcome", "in": ["hit", "critical"]}}
      ]
    },
    {
      "family_id": "activity.test",
      "parameters": {
        "dc": {"source_class": "INVOCATION_ADJUDICATED", "value_type": "integer", "cardinality": "single", "required": true, "minimum": 1, "maximum": 30}
      },
      "steps": [{"op": "op.resolve_check", "args": {"dc_parameter": "dc"}}]
    }
  ]
}
