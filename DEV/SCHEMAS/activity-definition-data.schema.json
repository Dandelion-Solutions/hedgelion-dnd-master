{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/activity-definition-data.schema.json",
  "title": "HDM definition.activity data",
  "type": "object",
  "additionalProperties": false,
  "required": ["family_id", "steps"],
  "properties": {
    "family_id": {"$ref": "#/$defs/machineId"},
    "activation": {"$ref": "#/$defs/activation"},
    "requirements": {
      "$ref": "https://hedgelion.invalid/schemas/mechanical-predicate.schema.json"
    },
    "targeting": {"$ref": "#/$defs/targeting"},
    "costs": {
      "type": "array",
      "items": {"$ref": "#/$defs/cost"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "details": {"type": "object"}
  },
  "$defs": {
    "machineId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "resultName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "economy_id": {"$ref": "#/$defs/machineId"},
        "amount": {"type": "integer", "minimum": 0}
      }
    },
    "targeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind_id"],
      "properties": {
        "kind_id": {"$ref": "#/$defs/machineId"},
        "minimum": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 0},
        "range_mode_id": {"$ref": "#/$defs/machineId"},
        "area": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shape_id"],
          "properties": {
            "shape_id": {"$ref": "#/$defs/machineId"},
            "size": {"type": "number", "exclusiveMinimum": 0},
            "unit_id": {"$ref": "#/$defs/machineId"}
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_ref", "amount"],
      "properties": {
        "resource_ref": {"$ref": "#/$defs/machineId"},
        "amount": {"type": "integer", "minimum": 0},
        "commitment_id": {"$ref": "#/$defs/machineId"}
      }
    },
    "resultCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "in"],
      "properties": {
        "result": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "in": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": ["string", "number", "integer", "boolean"]}
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {
          "type": "string",
          "pattern": "^op\\.[a-z][a-z0-9_]*$"
        },
        "args": {
          "type": "object",
          "description": "Validated again against the exact schema registered for op."
        },
        "when": {
          "oneOf": [
            {"$ref": "#/$defs/resultCondition"},
            {
              "$ref": "https://hedgelion.invalid/schemas/mechanical-predicate.schema.json"
            }
          ]
        },
        "export": {"$ref": "#/$defs/resultName"}
      }
    }
  },
  "examples": [
    {
      "family_id": "activity.attack",
      "activation": {"economy_id": "resource.action", "amount": 1},
      "targeting": {
        "kind_id": "target.entity",
        "minimum": 1,
        "maximum": 1,
        "range_mode_id": "range.reachable"
      },
      "steps": [
        {"op": "op.resolve_attack", "export": "attack"},
        {
          "op": "op.apply_damage",
          "when": {"result": "attack.outcome", "in": ["hit", "critical"]}
        }
      ]
    }
  ]
}
