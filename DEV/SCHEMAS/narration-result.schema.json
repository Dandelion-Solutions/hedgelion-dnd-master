{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/narration-result.schema.json",
  "title": "HDM recipient-scoped NarrationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "purpose", "source_generation", "response_language", "recipient_id", "bundle_id", "prose", "disclosure_refs"],
  "properties": {
    "kind": {"const": "narration_result"},
    "purpose": {"type": "string", "minLength": 1},
    "source_generation": {"type": "string", "minLength": 1},
    "response_language": {"type": "string", "minLength": 1},
    "recipient_id": {"type": "string", "minLength": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "prose": {"type": "string", "minLength": 1},
    "disclosure_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "examples": [{"kind": "narration_result", "purpose": "narrate", "source_generation": "frontier-7", "response_language": "locale:en-US", "recipient_id": "player-1", "bundle_id": "bundle-1", "prose": "You hear a bell.", "disclosure_refs": ["fact.bell"]}]
}
