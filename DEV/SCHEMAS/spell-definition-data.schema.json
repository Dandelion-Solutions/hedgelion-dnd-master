{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/spell-definition-data.schema.json",
  "title": "HDM definition.spell data",
  "type": "object",
  "additionalProperties": false,
  "required": ["level", "school_id", "activity_ids"],
  "properties": {
    "level": {"type": "integer", "minimum": 0, "maximum": 9},
    "school_id": {"$ref": "#/$defs/id"},
    "activity_ids": {"$ref": "#/$defs/idSet"},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verbal": {"type": "boolean"},
        "somatic": {"type": "boolean"},
        "material": {"type": "string", "minLength": 1}
      }
    },
    "concentration": {"type": "boolean"},
    "ritual": {"type": "boolean"},
    "choice_slots": {"type": "array", "items": {"$ref": "https://hedgelion.invalid/schemas/build-choice-slot.schema.json"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "description": "Executable casting time, targeting, range, costs, saves/attacks and created Effect duration live in linked Activities/Effects. Spell metadata must not duplicate those mutable/executable contracts."
}
