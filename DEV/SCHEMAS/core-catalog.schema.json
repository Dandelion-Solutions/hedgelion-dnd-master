{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/core-catalog.schema.json",
  "title": "HDM reviewed engine catalog seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "schema_version", "registries"],
  "properties": {
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {"const": 1},
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_definition_kinds", "world_record_kinds",
        "runtime_record_kinds", "protocol_value_kinds", "actor_facets",
        "asset_facets", "location_facets", "organization_facets",
        "activity_families", "activity_primitives", "transition_kinds",
        "event_kinds", "resource_mechanics", "effect_facets",
        "rule_operations", "rule_selectors", "target_kinds", "area_shapes",
        "range_modes", "signal_kinds", "duration_modes", "duration_units",
        "recovery_triggers", "stacking_behaviors", "resolution_states",
        "intent_execution_states", "mapping_outcomes", "canonicality_classes",
        "durability_classes", "publication_states", "knowledge_modes",
        "truth_statuses"
      ],
      "properties": {
        "content_definition_kinds": {"$ref": "#/$defs/idRegistry"},
        "world_record_kinds": {"$ref": "#/$defs/idRegistry"},
        "runtime_record_kinds": {"$ref": "#/$defs/idRegistry"},
        "protocol_value_kinds": {"$ref": "#/$defs/idRegistry"},
        "actor_facets": {"$ref": "#/$defs/idRegistry"},
        "asset_facets": {"$ref": "#/$defs/idRegistry"},
        "location_facets": {"$ref": "#/$defs/idRegistry"},
        "organization_facets": {"$ref": "#/$defs/idRegistry"},
        "activity_families": {"$ref": "#/$defs/idRegistry"},
        "activity_primitives": {"$ref": "#/$defs/idRegistry"},
        "transition_kinds": {"$ref": "#/$defs/idRegistry"},
        "event_kinds": {"$ref": "#/$defs/idRegistry"},
        "resource_mechanics": {"$ref": "#/$defs/idRegistry"},
        "effect_facets": {"$ref": "#/$defs/idRegistry"},
        "rule_operations": {"$ref": "#/$defs/idRegistry"},
        "rule_selectors": {"$ref": "#/$defs/idRegistry"},
        "target_kinds": {"$ref": "#/$defs/idRegistry"},
        "area_shapes": {"$ref": "#/$defs/idRegistry"},
        "range_modes": {"$ref": "#/$defs/idRegistry"},
        "signal_kinds": {"$ref": "#/$defs/idRegistry"},
        "duration_modes": {"$ref": "#/$defs/idRegistry"},
        "duration_units": {"$ref": "#/$defs/idRegistry"},
        "recovery_triggers": {"$ref": "#/$defs/idRegistry"},
        "stacking_behaviors": {"$ref": "#/$defs/idRegistry"},
        "resolution_states": {"$ref": "#/$defs/idRegistry"},
        "intent_execution_states": {"$ref": "#/$defs/idRegistry"},
        "mapping_outcomes": {"$ref": "#/$defs/idRegistry"},
        "canonicality_classes": {"$ref": "#/$defs/idRegistry"},
        "durability_classes": {"$ref": "#/$defs/idRegistry"},
        "publication_states": {"$ref": "#/$defs/idRegistry"},
        "knowledge_modes": {"$ref": "#/$defs/idRegistry"},
        "truth_statuses": {"$ref": "#/$defs/idRegistry"}
      }
    }
  },
  "$defs": {
    "idRegistry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      }
    }
  }
}
