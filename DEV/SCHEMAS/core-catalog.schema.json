{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/core-catalog.schema.json",
  "title": "HDM reviewed engine catalog seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_generation", "schema_version", "registries"],
  "properties": {
    "catalog_generation": {"const": 2},
    "schema_version": {"const": 2},
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_definition_kinds", "world_record_kinds",
        "runtime_record_kinds", "protocol_value_kinds", "actor_facets",
        "asset_facets", "location_facets", "organization_facets",
        "activity_families", "activity_primitives", "transition_kinds",
        "event_kinds", "resource_mechanics", "effect_facets",
        "rule_operations", "rule_selectors", "mechanical_accessors",
        "life_states", "life_state_policies",
        "condition_aggregation_policies", "condition_rule_scopes",
        "condition_boundary_response_operations",
        "effect_reapplication_match_policies", "effect_reapplication_actions",
        "effect_arbitration_policies", "effect_lifecycle_states",
        "effect_terminal_reasons", "boundary_kinds", "temporal_binding_kinds",
        "resource_recovery_operations", "target_kinds", "area_shapes",
        "range_modes", "signal_kinds", "duration_modes", "duration_units",
        "resolution_states", "command_dispositions", "execution_failure_codes",
        "intent_execution_states", "mapping_outcomes", "truth_statuses",
        "lore_record_statuses", "epistemic_stances", "disclosure_aspects",
        "semantic_survival_states", "current_durability_states",
        "durability_obligation_kinds", "repository_ref_outcomes",
        "actor_continuity_lifetimes", "actor_cognition_purposes",
        "actor_relationship_facets", "logical_roles",
        "context_discovery_channels", "context_representation_classes",
        "context_assembly_outcomes", "story_service_outcomes",
        "collaboration_coordination_families", "input_semantic_classes",
        "collaboration_states", "collaboration_nonaction_results",
        "planning_entry_classes", "chronology_relation_kinds",
        "recovery_outcomes", "story_layers", "story_candidate_dispositions",
        "message_payload_states"
      ],
      "properties": {
        "content_definition_kinds": {"$ref": "#/$defs/idRegistry"},
        "world_record_kinds": {"$ref": "#/$defs/idRegistry"},
        "runtime_record_kinds": {"$ref": "#/$defs/idRegistry"},
        "protocol_value_kinds": {"$ref": "#/$defs/idRegistry"},
        "actor_facets": {"$ref": "#/$defs/idRegistry"},
        "asset_facets": {"$ref": "#/$defs/idRegistry"},
        "location_facets": {"$ref": "#/$defs/idRegistry"},
        "organization_facets": {"$ref": "#/$defs/idRegistry"},
        "activity_families": {"$ref": "#/$defs/idRegistry"},
        "activity_primitives": {"$ref": "#/$defs/idRegistry"},
        "transition_kinds": {"$ref": "#/$defs/idRegistry"},
        "event_kinds": {"$ref": "#/$defs/idRegistry"},
        "resource_mechanics": {"$ref": "#/$defs/idRegistry"},
        "effect_facets": {"$ref": "#/$defs/idRegistry"},
        "rule_operations": {"$ref": "#/$defs/idRegistry"},
        "rule_selectors": {"$ref": "#/$defs/idRegistry"},
        "mechanical_accessors": {"$ref": "#/$defs/idRegistry"},
        "life_states": {"$ref": "#/$defs/idRegistry"},
        "life_state_policies": {"$ref": "#/$defs/idRegistry"},
        "condition_aggregation_policies": {"$ref": "#/$defs/idRegistry"},
        "condition_rule_scopes": {"$ref": "#/$defs/idRegistry"},
        "condition_boundary_response_operations": {"$ref": "#/$defs/idRegistry"},
        "effect_reapplication_match_policies": {"$ref": "#/$defs/idRegistry"},
        "effect_reapplication_actions": {"$ref": "#/$defs/idRegistry"},
        "effect_arbitration_policies": {"$ref": "#/$defs/idRegistry"},
        "effect_lifecycle_states": {"$ref": "#/$defs/idRegistry"},
        "effect_terminal_reasons": {"$ref": "#/$defs/idRegistry"},
        "boundary_kinds": {"$ref": "#/$defs/idRegistry"},
        "temporal_binding_kinds": {"$ref": "#/$defs/idRegistry"},
        "resource_recovery_operations": {"$ref": "#/$defs/idRegistry"},
        "target_kinds": {"$ref": "#/$defs/idRegistry"},
        "area_shapes": {"$ref": "#/$defs/idRegistry"},
        "range_modes": {"$ref": "#/$defs/idRegistry"},
        "signal_kinds": {"$ref": "#/$defs/idRegistry"},
        "duration_modes": {"$ref": "#/$defs/idRegistry"},
        "duration_units": {"$ref": "#/$defs/idRegistry"},
        "resolution_states": {"$ref": "#/$defs/idRegistry"},
        "command_dispositions": {"$ref": "#/$defs/idRegistry"},
        "execution_failure_codes": {"$ref": "#/$defs/idRegistry"},
        "intent_execution_states": {"$ref": "#/$defs/idRegistry"},
        "mapping_outcomes": {"$ref": "#/$defs/idRegistry"},
        "truth_statuses": {"$ref": "#/$defs/idRegistry"},
        "lore_record_statuses": {"$ref": "#/$defs/idRegistry"},
        "epistemic_stances": {"$ref": "#/$defs/idRegistry"},
        "disclosure_aspects": {"$ref": "#/$defs/idRegistry"},
        "semantic_survival_states": {"$ref": "#/$defs/idRegistry"},
        "current_durability_states": {"$ref": "#/$defs/idRegistry"},
        "durability_obligation_kinds": {"$ref": "#/$defs/idRegistry"},
        "repository_ref_outcomes": {"$ref": "#/$defs/idRegistry"},
        "actor_continuity_lifetimes": {"$ref": "#/$defs/idRegistry"},
        "actor_cognition_purposes": {"$ref": "#/$defs/idRegistry"},
        "actor_relationship_facets": {"$ref": "#/$defs/idRegistry"},
        "logical_roles": {"$ref": "#/$defs/idRegistry"},
        "context_discovery_channels": {"$ref": "#/$defs/idRegistry"},
        "context_representation_classes": {"$ref": "#/$defs/idRegistry"},
        "context_assembly_outcomes": {"$ref": "#/$defs/idRegistry"},
        "story_service_outcomes": {"$ref": "#/$defs/idRegistry"},
        "collaboration_coordination_families": {"$ref": "#/$defs/idRegistry"},
        "input_semantic_classes": {"$ref": "#/$defs/idRegistry"},
        "collaboration_states": {"$ref": "#/$defs/idRegistry"},
        "collaboration_nonaction_results": {"$ref": "#/$defs/idRegistry"},
        "planning_entry_classes": {"$ref": "#/$defs/idRegistry"},
        "chronology_relation_kinds": {"$ref": "#/$defs/idRegistry"},
        "recovery_outcomes": {"$ref": "#/$defs/idRegistry"},
        "story_layers": {"$ref": "#/$defs/idRegistry"},
        "story_candidate_dispositions": {"$ref": "#/$defs/idRegistry"},
        "message_payload_states": {"$ref": "#/$defs/idRegistry"}
      }
    }
  },
  "$defs": {
    "idRegistry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      }
    }
  }
