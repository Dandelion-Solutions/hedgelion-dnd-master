{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/entity-structures.schema.json",
  "title": "HDM required/expected entity field inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "catalog_generation",
    "details_field",
    "details_semantics",
    "definitions",
    "world_records"
  ],
  "properties": {
    "catalog_generation": {"const": 2},
    "details_field": {"const": "details"},
    "details_semantics": {"type": "string", "minLength": 1},
    "definitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^definition\\.[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/fieldInventory"}
    },
    "world_records": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^world\\.[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/worldFieldInventory"}
    }
  },
  "$defs": {
    "fieldNameSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "definitionKindSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^definition\\.[a-z][a-z0-9_]*$"
      }
    },
    "definitionBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"const": "forbidden"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "allowed_definition_kinds"],
          "properties": {
            "mode": {"enum": ["optional", "required"]},
            "allowed_definition_kinds": {"$ref": "#/$defs/definitionKindSet"}
          }
        }
      ]
    },
    "fieldInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "expected"],
      "properties": {
        "required": {"$ref": "#/$defs/fieldNameSet"},
        "expected": {"$ref": "#/$defs/fieldNameSet"}
      }
    },
    "worldFieldInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "expected", "definition_binding"],
      "properties": {
        "required": {"$ref": "#/$defs/fieldNameSet"},
        "expected": {"$ref": "#/$defs/fieldNameSet"},
        "definition_binding": {"$ref": "#/$defs/definitionBinding"}
      }
    }
  }
}
