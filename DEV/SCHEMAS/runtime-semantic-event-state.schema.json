{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-semantic-event-state.schema.json",
  "title": "HDM runtime.semantic_event state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "semantic_order", "kind", "provenance_refs", "semantic_delta"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "semantic_order": {"type": "integer", "minimum": 1},
    "kind": {"type": "string", "minLength": 1},
    "provenance_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "semantic_delta": {
      "type": "object",
      "properties": {
        "discovery_refs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["family_key", "identity"],
            "properties": {
              "family_key": {"enum": ["world.scene", "world.actor", "world.actor_group", "world.asset", "world.location", "world.lore_fact", "world.player", "world.thread", "world.effect", "world.connection", "world.zone", "world.organization", "world.contract", "world.mission", "world.encounter", "world.hazard", "world.knowledge", "runtime.interaction", "runtime.intent_plan", "runtime.command", "runtime.procedure", "runtime.resolution", "runtime.continuation", "runtime.resolution_trace", "runtime.disclosure", "runtime.collaboration_obligation", "runtime.maintenance_audit", "runtime.catalog_gap_report", "runtime.semantic_event", "runtime.mechanical_event", "runtime.message", "runtime.checkpoint", "runtime.session"]},
              "identity": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "string", "minLength": 1}}
            },
            "allOf": [{"if": {"properties": {"family_key": {"enum": ["world.knowledge", "runtime.disclosure"]}}}, "then": {"properties": {"identity": {"minItems": 2, "maxItems": 2}}}, "else": {"properties": {"identity": {"maxItems": 1}}}}]
          }
        },
        "actor_decision_basis": {
          "$ref": "https://hedgelion.invalid/schemas/semantic-event-t0-basis.schema.json"
        }
      }
    }
  }
}
