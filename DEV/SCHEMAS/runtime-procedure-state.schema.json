{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-procedure-state.schema.json",
  "title": "HDM runtime.procedure state",
  "$comment": "schema_version 2 exposes the owner-native recovery lifecycle. lifecycle is exactly ACTIVE or TERMINAL; concrete Procedure phase fields are subtype-specific and do not replace it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lifecycle", "participant_resources"],
  "properties": {
    "schema_version": {"const": 2},
    "lifecycle": {"enum": ["ACTIVE", "TERMINAL"]},
    "participant_resources": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 1},
      "additionalProperties": {
        "type": "object",
        "propertyNames": {"type": "string", "minLength": 1},
        "additionalProperties": {"$ref": "#/$defs/spentResourceState"}
      }
    },
    "world_context_id": {"type": "string", "minLength": 1},
    "details": {"type": "object"}
  },
  "$defs": {
    "spentResourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spent"],
      "properties": {
        "spent": {"type": "integer", "minimum": 0}
      }
    }
  },
  "examples": [
    {
      "schema_version": 2,
      "lifecycle": "ACTIVE",
      "participant_resources": {
        "actor-0001": {
          "resource.action": {"spent": 1},
          "resource.reaction": {"spent": 0}
        }
      }
    }
  ]
}
