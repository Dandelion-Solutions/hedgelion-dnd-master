{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/commentator-snapshot.schema.json",
  "title": "HDM self-contained Commentator snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records", "control"],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/storyProjection"}
    },
    "control": {"$ref": "commentator-control-projection.schema.json"}
  },
  "$defs": {
    "storyProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "story_id",
        "content",
        "sources",
        "t0_basis",
        "availability"
      ],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "story_id": {
          "$ref": "story-unit-common.schema.json#/$defs/eventStoryRef"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "required": ["body"],
          "properties": {"body": {"type": "string", "minLength": 1}}
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "t0_basis": {"$ref": "semantic-event-t0-basis.schema.json"},
        "availability": {
          "type": "object",
          "additionalProperties": false,
          "required": ["visible_to"],
          "properties": {
            "visible_to": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
