{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/world-actor-state.schema.json",
  "title": "HDM world.actor state",
  "type": "object",
  "additionalProperties": false,
  "dependentRequired": {"hp": ["life_state_id"], "life_state_progress": ["life_state_id"]},
  "properties": {
    "name": {"$ref": "#/$defs/localizedText"},
    "concept": {"type": "string", "minLength": 1},
    "roles": {"$ref": "#/$defs/idSet"},
    "location_id": {"$ref": "#/$defs/id"},
    "build": {"$ref": "#/$defs/build"},
    "abilities": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/abilityComponents"}},
    "hp": {"$ref": "#/$defs/hp"},
    "life_state_id": {"$ref": "#/$defs/lifeStateId"},
    "life_state_policy_id": {"$ref": "#/$defs/lifePolicyId"},
    "life_state_progress": {"$ref": "#/$defs/lifeStateProgress"},
    "resources": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/resourceState"}},
    "continuity": {"$ref": "#/$defs/continuity"},
    "details": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"life_state_id": {"const": "life.dying"}}, "required": ["life_state_id"]}, "then": {"required": ["life_state_progress"], "properties": {"life_state_progress": {"$ref": "#/$defs/dyingProgress"}}}},
    {"if": {"properties": {"life_state_id": {"const": "life.stable"}}, "required": ["life_state_id"]}, "then": {"required": ["life_state_progress"], "properties": {"life_state_progress": {"$ref": "#/$defs/stableProgress"}}}},
    {"if": {"properties": {"life_state_id": {"enum": ["life.active", "life.dead"]}}, "required": ["life_state_id"]}, "then": {"not": {"required": ["life_state_progress"]}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "lifeStateId": {"enum": ["life.active", "life.dying", "life.stable", "life.dead"]},
    "lifePolicyId": {"enum": ["life_policy.dnd2024.character_like", "life_policy.dnd2024.monster_default"]},
    "idSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "localizedText": {"type": "object", "minProperties": 1, "maxProperties": 4, "propertyNames": {"pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"}, "additionalProperties": {"type": "string", "minLength": 1}},
    "classProgressionEntry": {
      "type": "object", "additionalProperties": false, "required": ["class_id", "level"],
      "properties": {"class_id": {"$ref": "#/$defs/id"}, "level": {"type": "integer", "minimum": 1}, "subclass_id": {"$ref": "#/$defs/id"}}
    },
    "classProgression": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/classProgressionEntry"}},
    "choiceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_option_ids"],
      "properties": {
        "selected_option_ids": {"$ref": "#/$defs/idSet"},
        "selection_basis": {
          "enum": ["choice_basis.player_explicit", "choice_basis.rules_inheritance", "choice_basis.concept_inference", "choice_basis.campaign_default", "choice_basis.delegated_default"]
        },
        "basis_ref": {"type": "string", "minLength": 1}
      }
    },
    "choiceBindings": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/choiceBinding"}},
    "spellcastingState": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"known_spell_ids": {"$ref": "#/$defs/idSet"}, "prepared_spell_ids": {"$ref": "#/$defs/idSet"}, "spellbook_spell_ids": {"$ref": "#/$defs/idSet"}}
    },
    "build": {
      "type": "object", "additionalProperties": false, "required": ["class_progression"],
      "properties": {"species_id": {"$ref": "#/$defs/id"}, "background_id": {"$ref": "#/$defs/id"}, "class_progression": {"$ref": "#/$defs/classProgression"}, "choice_bindings": {"$ref": "#/$defs/choiceBindings"}, "spellcasting": {"$ref": "#/$defs/spellcastingState"}}
    },
    "abilityComponents": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"base": {"type": "integer", "minimum": 0}, "adjustment": {"type": "integer"}}},
    "hp": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"current": {"type": "integer", "minimum": 0}, "maximum_base": {"type": "integer", "minimum": 0}, "maximum_adjustment": {"type": "integer"}, "temporary": {"type": "integer", "minimum": 0}}},
    "deathSaves": {"type": "object", "additionalProperties": false, "required": ["successes", "failures"], "properties": {"successes": {"type": "integer", "minimum": 0, "maximum": 2}, "failures": {"type": "integer", "minimum": 0, "maximum": 2}}},
    "dyingProgress": {"type": "object", "additionalProperties": false, "required": ["death_saves"], "properties": {"death_saves": {"$ref": "#/$defs/deathSaves"}}},
    "stableProgress": {"type": "object", "additionalProperties": false, "required": ["recovery_binding"], "properties": {"recovery_binding": {"$ref": "https://hedgelion.invalid/schemas/temporal-binding.schema.json"}}},
    "lifeStateProgress": {"oneOf": [{"$ref": "#/$defs/dyingProgress"}, {"$ref": "#/$defs/stableProgress"}]},
    "resourceState": {"type": "object", "additionalProperties": false, "required": ["current"], "properties": {"current": {"type": "number", "minimum": 0}, "recovery_binding": {"$ref": "https://hedgelion.invalid/schemas/temporal-binding.schema.json"}}},
    "continuityStatement": {"type": "object", "additionalProperties": false, "required": ["statement"], "properties": {"statement": {"type": "string", "minLength": 1}, "source_refs": {"$ref": "#/$defs/idSet"}}},
    "continuityStatementSet": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/continuityStatement"}},
    "foundationContinuity": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"values": {"$ref": "#/$defs/continuityStatementSet"}, "temperament": {"$ref": "#/$defs/continuityStatementSet"}, "identity": {"$ref": "#/$defs/continuityStatementSet"}}},
    "evolvingContinuity": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"long_term_goal": {"$ref": "#/$defs/continuityStatement"}, "current_objective": {"$ref": "#/$defs/continuityStatement"}, "next_intention": {"$ref": "#/$defs/continuityStatement"}, "material_commitments": {"$ref": "#/$defs/continuityStatementSet"}, "reconsideration_cues": {"$ref": "#/$defs/continuityStatementSet"}}},
    "relationshipLevel": {"enum": ["low", "moderate", "high"]},
    "relationshipFacets": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"trust": {"$ref": "#/$defs/relationshipLevel"}, "affinity": {"$ref": "#/$defs/relationshipLevel"}, "fear": {"$ref": "#/$defs/relationshipLevel"}, "respect": {"$ref": "#/$defs/relationshipLevel"}, "hostility": {"$ref": "#/$defs/relationshipLevel"}, "felt_obligation": {"$ref": "#/$defs/relationshipLevel"}}},
    "relationshipView": {"type": "object", "additionalProperties": false, "required": ["facets"], "properties": {"facets": {"$ref": "#/$defs/relationshipFacets"}, "basis_refs": {"$ref": "#/$defs/idSet"}, "last_changed_event_id": {"$ref": "#/$defs/id"}}},
    "relationships": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/relationshipView"}},
    "continuity": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"foundation": {"$ref": "#/$defs/foundationContinuity"}, "evolving": {"$ref": "#/$defs/evolvingContinuity"}, "relationships": {"$ref": "#/$defs/relationships"}}}
  },
  "examples": [
    {"concept": "огненный демон", "roles": ["actor.player_character"]},
    {"name": {"ru": "Бдыр"}},
    {
      "name": {"en": "Aria"},
      "build": {
        "species_id": "species.human",
        "background_id": "background.soldier",
        "class_progression": [{"class_id": "class.fighter", "level": 3}],
        "choice_bindings": {
          "advancement.fighter.level_1.style": {
            "selected_option_ids": ["choice.fighting_style.defense"],
            "selection_basis": "choice_basis.player_explicit"
          }
        }
      },
      "hp": {"current": 0, "maximum_base": 18},
      "life_state_id": "life.dying",
      "life_state_progress": {"death_saves": {"successes": 1, "failures": 0}}
    },
    {
      "name": {"en": "Mara"},
      "roles": ["actor.nonplayer_character"],
      "continuity": {
        "foundation": {"values": [{"statement": "Protect the village before personal gain"}]},
        "evolving": {"current_objective": {"statement": "Find who poisoned the well"}},
        "relationships": {"actor-0042": {"facets": {"trust": "high", "respect": "moderate"}}}
      }
    }
  ]
}
