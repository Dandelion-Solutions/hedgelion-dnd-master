{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/activity-primitive-contracts.schema.json",
  "title": "HDM Activity primitive contract catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "catalog_generation", "owner", "laws", "value_contracts", "read_contracts", "primitive_validation_matrix", "contracts"],
  "properties": {
    "schema_name": {"const": "hdm_activity_primitive_contracts"},
    "schema_version": {"const": 2},
    "catalog_generation": {"const": 2},
    "owner": {"const": "DEV/ARCHITECTURE/ACTIVITY_PRIMITIVE_CONTRACTS.md"},
    "laws": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "value_contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "validation"],
        "properties": {
          "owner": {"type": "string", "minLength": 1},
          "validation": {"const": "EXACT_NAMED_CONTRACT"},
          "schema_ref": {"type": "string", "pattern": "^DEV/SCHEMAS/"},
          "type": {"type": "string", "minLength": 1},
          "enum": {"type": "array", "minItems": 1, "uniqueItems": true},
          "one_of": {"type": "array", "minItems": 1},
          "catalog_ref": {"type": "string", "minLength": 1},
          "compiler_ref": {"type": "string", "minLength": 1}
        },
        "oneOf": [
          {"required": ["schema_ref"]}, {"required": ["type"]}, {"required": ["enum"]},
          {"required": ["one_of"]}, {"required": ["catalog_ref"]}, {"required": ["compiler_ref"]}
        ]
      }
    },
    "read_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SELECTOR", "ACCESSOR", "INVOCATION_FACT", "DOMAIN_OWNER", "INFRASTRUCTURE"],
      "properties": {
        "SELECTOR": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "ACCESSOR": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "INVOCATION_FACT": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "DOMAIN_OWNER": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "INFRASTRUCTURE": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "primitive_validation_matrix": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/primitiveValidationMatrix"}
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contract"}
    }
  },
  "$defs": {
    "typedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value_kind", "cardinality", "required", "source"],
      "properties": {
        "value_kind": {"type": "string", "minLength": 1},
        "cardinality": {"enum": ["single", "many"]},
        "required": {"type": "boolean"},
        "source": {"enum": ["ACTIVITY_ARGUMENT", "BOUND_ROLE", "ACCEPTED_INVOCATION_FACT", "PRIMITIVE_RESULT"]}
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "view"],
      "properties": {
        "kind": {"enum": ["BINDING", "ACCESSOR", "SELECTOR", "INVOCATION_FACT", "DOMAIN_OWNER", "INFRASTRUCTURE"]},
        "id": {"type": "string", "minLength": 1},
        "view": {"enum": ["PINNED_COMMITTED_OR_PROSPECTIVE", "FIXED_ACCEPTED_INVOCATION"]}
      }
    },
    "activationDependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requires_exact_seed_consumer", "required_active_primitive_ids", "required_active_value_kinds"],
      "properties": {
        "requires_exact_seed_consumer": {"const": true},
        "required_active_primitive_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^op\\.[a-z][a-z0-9_]*$"}},
        "required_active_value_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "causalRecovery": {
      "oneOf": [
        {"const": "NOT_APPLICABLE"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["causal_key", "recovery_owner", "retention"],
          "properties": {
            "causal_key": {"type": "string", "minLength": 1},
            "recovery_owner": {"type": "string", "minLength": 1},
            "retention": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "primitiveValidationMatrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_policy", "storage_policy", "failure_policy", "validation_policy", "segment_semantics", "compiler_form_propagation", "activation_dependencies", "causal_recovery", "chronology_barrier"],
      "properties": {
        "subject_policy": {"type": "string", "minLength": 1},
        "storage_policy": {"type": "string", "minLength": 1},
        "failure_policy": {"const": "EXACT_CONTRACT_FAILURE_CODES"},
        "validation_policy": {"const": "EXACT_CONTRACT_ARGUMENT_AND_RESULT_VALUE_CONTRACTS"},
        "segment_semantics": {"enum": ["ONE_SEGMENT", "CHILD_STEPS_DEFINE_SEGMENTS", "SUSPENSION_STATE_ONLY", "PENDING_CHILD_IDENTITY_ATOMIC_WITH_TRIGGERING_COMMIT", "QUARANTINED_NO_EXECUTION"]},
        "compiler_form_propagation": {"enum": ["NOT_COMPILER_FORM", "CHILD_STEPS_ONLY_WITH_ENCLOSING_SEGMENT_INHERITANCE"]},
        "activation_dependencies": {"$ref": "#/$defs/activationDependencies"},
        "causal_recovery": {"$ref": "#/$defs/causalRecovery"},
        "chronology_barrier": {"type": "string", "minLength": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primitive_id", "family", "execution_kind", "realization_state", "selection_state", "activation_trigger", "arguments", "results", "reads", "rng", "prospective_outputs", "atomicity", "suspension", "failures", "bounds", "evidence"],
      "properties": {
        "primitive_id": {"type": "string", "pattern": "^op\\.[a-z][a-z0-9_]*$"},
        "family": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "execution_kind": {"enum": ["CALCULATION", "MUTATION", "COMPILER_FORM", "SUSPENSION", "FOLLOWUP", "TEMPORAL"]},
        "realization_state": {"enum": ["QUARANTINED", "COMPLETE"]},
        "selection_state": {"enum": ["DORMANT_NONSELECTABLE", "QUARANTINED_NO_EXACT_CLOSED_VARIANT", "ACTIVE_ADMITTED"]},
        "activation_trigger": {"enum": ["S6D_07_TO_09_EXACT_COMPILED_SEED_CONSUMER_AND_ACTIVE_DEPENDENCIES", "EXACT_CLOSED_EVENT_VARIANT_AND_ACTIVE_DEPENDENCIES"]},
        "exact_seed_consumer_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^activity\\."}},
        "authority_denied": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "arguments": {"type": "object", "additionalProperties": {"$ref": "#/$defs/typedValue"}},
        "results": {"type": "object", "additionalProperties": {"$ref": "#/$defs/typedValue"}},
        "reads": {"type": "array", "items": {"$ref": "#/$defs/read"}},
        "rng": {"type": "object", "additionalProperties": false, "required": ["policy"], "properties": {"policy": {"enum": ["NONE", "ONE_FIXED_RESULT_PER_REQUEST_AND_GENERATION"]}, "request_owner": {"type": "string", "minLength": 1}, "result_owner": {"type": "string", "minLength": 1}, "authority": {"type": "string", "minLength": 1}}},
        "prospective_outputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transition_kinds", "event_kinds", "state_delta_policy"],
          "properties": {
            "transition_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^transition\\."}},
            "event_kinds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^event\\."}},
            "state_delta_policy": {"const": "PRIMITIVE_LOCAL_TYPED_PROSPECTIVE_ONLY"}
          }
        },
        "atomicity": {"type": "object", "additionalProperties": false, "required": ["owner", "policy"], "properties": {"owner": {"const": "EXECUTION_SEGMENT"}, "policy": {"type": "string", "minLength": 1}}},
        "suspension": {"type": "object", "additionalProperties": false, "required": ["kind", "retention"], "properties": {"kind": {"enum": ["NONE", "CHOICE", "REACTION"]}, "retention": {"type": "string", "minLength": 1}}},
        "failures": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^failure\\."}},
        "bounds": {"type": "array", "uniqueItems": true, "items": {"enum": ["target_count", "step_count", "branch_depth", "trigger_chain_depth", "boundary_occurrence_count", "one_entitlement", "current_turn_only", "next_eligible_activation_once", "one_effect_instance", "one_minute_duration", "same_source_target_definition_replacement"]}},
        "evidence": {"type": "object", "additionalProperties": false, "required": ["commit_disposition_owner", "committed_fact_owner", "outcome_owner", "trace_policy"], "properties": {"commit_disposition_owner": {"const": "EXECUTION_SEGMENT"}, "committed_fact_owner": {"const": "MECHANICAL_EVENT"}, "outcome_owner": {"const": "RESOLUTION_RECEIPT"}, "trace_policy": {"type": "string", "minLength": 1}}}
      }
    }
  }
}
