{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/native-history-currentness.schema.json",
  "title": "HDM native semantic history currentness evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "origin", "source_revision", "accepted_event_fingerprints"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "pattern": "^(LOCAL|LIVE:[A-Za-z0-9_.:-]+)$"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
    "accepted_event_fingerprints": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  }
}
