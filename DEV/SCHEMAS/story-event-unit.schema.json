{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/story-event-unit.schema.json",
  "title": "HDM Story EVENTS unit",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "story_id", "content", "sources", "t0_basis", "availability"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "story_id": {"type": "string", "pattern": "^E[0-9]{6,}$"},
    "content": {"type": "object", "additionalProperties": false, "required": ["body"], "properties": {"body": {"type": "string", "minLength": 1}}},
    "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "t0_basis": {"$ref": "semantic-event-t0-basis.schema.json"},
    "availability": {"type": "object", "additionalProperties": false, "required": ["visible_to"], "properties": {"visible_to": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
  }
}
