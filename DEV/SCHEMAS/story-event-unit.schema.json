{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/story-event-unit.schema.json",
  "title": "HDM Story EVENTS unit",
  "allOf": [
    {"$ref": "story-unit-common.schema.json#/$defs/storyUnit"},
    {
      "type": "object",
      "required": ["payload"],
      "properties": {
        "schema_version": {"const": 3},
        "story_id": {
          "$ref": "story-unit-common.schema.json#/$defs/eventStoryRef"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {"required": ["event_source_keys"]},
            {"required": ["relation_source_keys"]}
          ],
          "properties": {
            "event_source_keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "story-unit-common.schema.json#/$defs/localKey"}
            },
            "relation_source_keys": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "story-unit-common.schema.json#/$defs/localKey"}
            },
            "t0_basis": {"$ref": "semantic-event-t0-basis.schema.json"}
          }
        }
      }
    }
  ]
}
