{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/collaboration-closed-basis.schema.json",
  "title": "HDM runtime.collaboration_closed_basis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "campaign_id",
    "obligation_id",
    "generation",
    "closed_input_set_fingerprint",
    "accepted_input_uses",
    "accepted_input_contributors"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "runtime.collaboration_closed_basis"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "obligation_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1},
    "closed_input_set_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "accepted_input_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/inputUse"}
    },
    "accepted_input_contributors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/inputContributor"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "inputUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_id", "clause_id"],
      "properties": {
        "interaction_id": {"$ref": "#/$defs/id"},
        "clause_id": {"$ref": "#/$defs/id"}
      }
    },
    "inputContributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interaction_id", "clause_id", "player_id"],
      "properties": {
        "interaction_id": {"$ref": "#/$defs/id"},
        "clause_id": {"$ref": "#/$defs/id"},
        "player_id": {"$ref": "#/$defs/id"},
        "pc_id": {"$ref": "#/$defs/id"}
      }
    }
  }
}
