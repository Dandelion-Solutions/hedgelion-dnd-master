{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/world-thread-state.schema.json",
  "title": "HDM native world.thread state",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_kind", "id", "state_revision", "status", "kind", "state", "temporal"],
  "properties": {
    "record_kind": {"const": "world.thread"},
    "id": {"$ref": "#/$defs/threadId"},
    "state_revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["active", "paused", "resolved", "failed", "obsolete"]},
    "kind": {"enum": ["threat", "goal", "project", "countdown", "investigation", "pursuit", "custom"]},
    "owner_entity_id": {"$ref": "#/$defs/machineId"},
    "state": {"$ref": "#/$defs/processState"},
    "temporal": {"$ref": "#/$defs/temporalOccurrence"},
    "created_event_id": {"$ref": "#/$defs/machineId"},
    "last_event_id": {"$ref": "#/$defs/machineId"}
  },
  "$defs": {
    "machineId": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "threadId": {"type": "string", "pattern": "^THREAD_[A-Za-z0-9_.:-]+$"},
    "processState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "progress"],
      "properties": {"stage": {"type": ["string", "null"]}, "progress": {"type": ["object", "null"]}}
    },
    "temporalOccurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "occurrence_id", "occurrence_state", "binding", "dependency_keys"],
      "properties": {
        "binding_id": {"$ref": "#/$defs/machineId"},
        "occurrence_id": {"$ref": "#/$defs/machineId"},
        "occurrence_state": {"enum": ["ARMED", "CLAIMED", "CLOSED"]},
        "binding": {"$ref": "https://hedgelion.invalid/schemas/temporal-binding.schema.json"},
        "dependency_keys": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(METRIC_POSITION|BOUNDARY_OCCURRENCE|EVENT_OR_SIGNAL|RELATION_EVIDENCE|OWNER_LOCAL_TEMPORAL_STATE):.+$"}}
      },
      "allOf": [{
        "if": {"properties": {"occurrence_state": {"const": "ARMED"}}, "required": ["occurrence_state"]},
        "then": {"properties": {"dependency_keys": {"minItems": 1}}}
      }]
    }
  }
}
