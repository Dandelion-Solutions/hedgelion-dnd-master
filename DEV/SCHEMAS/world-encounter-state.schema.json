{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/world-encounter-state.schema.json",
  "title": "HDM world.encounter state",
  "type": "object",
  "additionalProperties": false,
  "required": ["participant_ids", "status"],
  "properties": {
    "participant_ids": {"$ref": "#/$defs/idSet"},
    "status": {"type": "object"},
    "scene_id": {"$ref": "#/$defs/id"},
    "active_procedure_id": {"$ref": "#/$defs/id"},
    "details": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
