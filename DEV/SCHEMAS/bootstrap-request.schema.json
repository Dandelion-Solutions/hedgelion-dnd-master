{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/bootstrap-request.schema.json",
  "title": "HDM bounded campaign scaffold input",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "campaign_branch", "created_at", "creator_github_login", "mode", "engine_version", "package_id", "source_commit_sha", "package_sha256", "ruleset_set_sha256"],
  "properties": {
    "campaign_id": {"type": "string", "pattern": "^campaign\\.[0-9a-f]{32}$"},
    "campaign_branch": {"type": "string", "pattern": "^campaign/[0-9]{8}(?:-[0-9]+)?$"},
    "created_at": {"type": "string", "format": "date-time"},
    "creator_github_login": {"type": "string", "minLength": 1},
    "mode": {"enum": ["singleplayer", "multiplayer"]},
    "engine_version": {"type": "string", "minLength": 1},
    "package_id": {"type": "string", "minLength": 1},
    "source_commit_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ruleset_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
