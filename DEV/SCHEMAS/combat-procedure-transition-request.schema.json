{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/combat-procedure-transition-request.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/initialize"}, {"$ref": "#/$defs/startTurn"}, {"$ref": "#/$defs/spendAction"},
    {"$ref": "#/$defs/endTurn"}, {"$ref": "#/$defs/advanceRound"}, {"$ref": "#/$defs/terminate"}
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "baseProperties": {
      "idempotency_key": {"$ref": "#/$defs/id"}, "catalog_generation": {"const": "2.0.0"},
      "procedure_id": {"$ref": "#/$defs/id"}, "procedure_revision": {"type": "integer", "minimum": 0}
    },
    "initiativeEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "roll_total", "rng_result_ref", "tie_break_rank"],
      "properties": {"actor_id": {"$ref": "#/$defs/id"}, "roll_total": {"type": "integer"}, "rng_result_ref": {"$ref": "#/$defs/id"}, "tie_break_rank": {"type": "integer", "minimum": 1}}
    },
    "initialize": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "idempotency_key", "catalog_generation", "procedure_id", "procedure_revision", "initiative_entries", "action_capacity", "movement_capacity"],
      "properties": {
        "profile_id": {"const": "procedure.initialize"}, "idempotency_key": {"$ref": "#/$defs/id"}, "catalog_generation": {"const": "2.0.0"}, "procedure_id": {"$ref": "#/$defs/id"}, "procedure_revision": {"const": 0},
        "initiative_entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/initiativeEntry"}},
        "action_capacity": {"type": "integer", "minimum": 0}, "movement_capacity": {"type": "integer", "minimum": 0}
      }
    },
    "turnBase": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "idempotency_key", "catalog_generation", "procedure_id", "procedure_revision", "actor_id"],
      "properties": {"profile_id": {"enum": ["procedure.start_turn", "procedure.spend_action", "procedure.end_turn"]}, "idempotency_key": {"$ref": "#/$defs/id"}, "catalog_generation": {"const": "2.0.0"}, "procedure_id": {"$ref": "#/$defs/id"}, "procedure_revision": {"type": "integer", "minimum": 1}, "actor_id": {"$ref": "#/$defs/id"}, "amount": {"type": "integer", "minimum": 1}}
    },
    "startTurn": {"allOf": [{"$ref": "#/$defs/turnBase"}, {"properties": {"profile_id": {"const": "procedure.start_turn"}}, "not": {"required": ["amount"]}}]},
    "spendAction": {"allOf": [{"$ref": "#/$defs/turnBase"}, {"properties": {"profile_id": {"const": "procedure.spend_action"}}, "required": ["amount"]}]},
    "endTurn": {"allOf": [{"$ref": "#/$defs/turnBase"}, {"properties": {"profile_id": {"const": "procedure.end_turn"}}, "not": {"required": ["amount"]}}]},
    "procedureBase": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "idempotency_key", "catalog_generation", "procedure_id", "procedure_revision"],
      "properties": {"profile_id": {"enum": ["procedure.advance_round", "procedure.terminate"]}, "idempotency_key": {"$ref": "#/$defs/id"}, "catalog_generation": {"const": "2.0.0"}, "procedure_id": {"$ref": "#/$defs/id"}, "procedure_revision": {"type": "integer", "minimum": 1}}
    },
    "advanceRound": {"allOf": [{"$ref": "#/$defs/procedureBase"}, {"properties": {"profile_id": {"const": "procedure.advance_round"}}}]},
    "terminate": {"allOf": [{"$ref": "#/$defs/procedureBase"}, {"properties": {"profile_id": {"const": "procedure.terminate"}}}]}
  }
}
