{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/live-claim.schema.json",
  "title": "HDM immutable typed LIVE claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["claim_type"],
  "properties": {
    "claim_type": {
      "enum": ["EXACT_OWNER", "EPOCH_LOCAL_CREATION", "OWNER_DEFINED_PARTITION"]
    },
    "native_family": {
      "type": "string",
      "pattern": "^(world|runtime)\\.[a-z][a-z0-9_]*$",
      "not": {
        "enum": [
          "world.player",
          "runtime.session",
          "runtime.collaboration_obligation",
          "runtime.checkpoint",
          "runtime.id_allocator",
          "runtime.maintenance_audit",
          "runtime.catalog_gap_report"
        ]
      }
    },
    "native_identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "partition_type": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "partition_key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    }
  },
  "oneOf": [
    {
      "required": ["claim_type", "native_family", "native_identity"],
      "properties": {
        "claim_type": {"const": "EXACT_OWNER"}
      },
      "not": {
        "anyOf": [
          {"required": ["partition_type"]},
          {"required": ["partition_key"]}
        ]
      }
    },
    {
      "required": ["claim_type", "native_family"],
      "properties": {
        "claim_type": {"const": "EPOCH_LOCAL_CREATION"}
      },
      "not": {
        "anyOf": [
          {"required": ["native_identity"]},
          {"required": ["partition_type"]},
          {"required": ["partition_key"]}
        ]
      }
    },
    {
      "required": ["claim_type", "partition_type", "partition_key"],
      "properties": {
        "claim_type": {"const": "OWNER_DEFINED_PARTITION"}
      },
      "not": {
        "anyOf": [
          {"required": ["native_family"]},
          {"required": ["native_identity"]}
        ]
      }
    }
  ]
}
