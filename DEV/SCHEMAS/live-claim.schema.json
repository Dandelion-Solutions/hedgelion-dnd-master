{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/live-claim.schema.json",
  "title": "HDM immutable typed LIVE claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_type", "native_family", "native_identity"],
  "properties": {
    "schema_version": {"const": 2},
    "claim_type": {
      "const": "EXACT_OWNER"
    },
    "native_family": {
      "type": "string",
      "pattern": "^(world|runtime)\\.[a-z][a-z0-9_]*$",
      "not": {
        "enum": [
          "world.player",
          "runtime.session",
          "runtime.collaboration_obligation",
          "runtime.checkpoint",
          "runtime.id_allocator",
          "runtime.maintenance_audit",
          "runtime.catalog_gap_report"
        ]
      }
    },
    "native_identity": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "partition_type": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "partition_key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    }
  },
  "not": {
    "anyOf": [
      {"required": ["partition_type"]},
      {"required": ["partition_key"]}
    ]
  }
}
