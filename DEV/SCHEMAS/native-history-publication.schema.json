{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/native-history-publication.schema.json",
  "title": "HDM native semantic history publication",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "campaign_id", "origin", "source_revision", "accepted_event_fingerprints", "events"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "kind": {"const": "runtime.native_history"},
    "campaign_id": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "pattern": "^(LOCAL|LIVE:[A-Za-z0-9_.:-]+)$"},
    "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
    "accepted_event_fingerprints": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "provenance"],
        "properties": {
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schema_version", "event_id", "semantic_order", "kind", "provenance_refs", "semantic_delta"],
            "properties": {
              "schema_version": {"type": "integer", "const": 1},
              "event_id": {"type": "string", "minLength": 1},
              "semantic_order": {"type": "integer", "minimum": 1},
              "kind": {"type": "string", "minLength": 1},
              "provenance_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "semantic_delta": {"type": "object"}
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["campaign_id", "origin", "source_revision", "event_id", "provenance_refs"],
            "properties": {
              "campaign_id": {"type": "string", "minLength": 1},
              "origin": {"type": "string", "pattern": "^(LOCAL|LIVE:[A-Za-z0-9_.:-]+)$"},
              "source_revision": {"type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"},
              "event_id": {"type": "string", "minLength": 1},
              "provenance_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  }
}
