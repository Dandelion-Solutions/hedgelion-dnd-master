{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/activity-compiler-declaration.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["roles", "symbols", "profiles"],
  "properties": {
    "parameters": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}, "additionalProperties": {"$ref": "https://hedgelion.invalid/schemas/activity-parameter-spec.schema.json"}},
    "roles": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}, "additionalProperties": {"type": "string", "enum": ["world.actor", "world.asset", "runtime.procedure"]}},
    "symbols": {"type": "object", "propertyNames": {"pattern": "^compiled\\.[a-z][a-z0-9_]*$"}, "additionalProperties": {"$ref": "#/$defs/symbol"}},
    "profiles": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://hedgelion.invalid/schemas/spell-native-profile-values.schema.json#/$defs/profileBinding"}}
  },
  "$defs": {
    "symbol": {
      "type": "object", "additionalProperties": false,
      "required": ["value_kind", "cardinality", "dependencies", "reads", "permitted_occurrence_ids"],
      "oneOf": [{"required": ["value"], "not": {"required": ["template"]}}, {"required": ["template"], "not": {"required": ["value"]}}],
      "properties": {
        "value_kind": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "cardinality": {"enum": ["single", "many"]},
        "scope": {"type": "object", "additionalProperties": false,
          "required": ["name", "value_kind", "family_key"], "properties": {
            "name": {"const": "target"}, "value_kind": {"const": "entity_ref"},
            "family_key": {"enum": ["world.actor", "world.asset"]}}},
        "value": {},
        "template": {"oneOf": [{
          "type": "object", "additionalProperties": false,
          "required": ["kind", "modifier_basis", "ability_parameter", "purpose_id", "roller_role"],
          "properties": {
            "kind": {"const": "D20_ABILITY_BASIS"},
            "modifier_basis": {"const": "AUTHORITATIVE_ABILITY_AND_PROFICIENCY"},
            "ability_parameter": {"const": "ability_id"},
            "proficiency_parameter": {"const": "proficiency_id"},
            "purpose_id": {"enum": ["roll.check", "roll.save"]},
            "roller_role": {"const": "actor"}
          }
        }, {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "modifier_basis", "prior_result_source", "original_dc_parameter", "roller_role"],
          "properties": {
            "kind": {"const": "D10_FIXED_FAILED_CHECK"},
            "modifier_basis": {"const": "FIXED_PRIOR_TOTAL"},
            "prior_result_source": {"const": "ACCEPTED_FAILED_ABILITY_CHECK"},
            "original_dc_parameter": {"const": "prior_check_dc"},
            "roller_role": {"const": "actor"}
          }
        }, {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "source_symbol", "input_contract"],
          "properties": {
            "kind": {"const": "HALF_DAMAGE_FLOOR_MIN_ZERO"},
            "source_symbol": {"type": "string", "pattern": "^compiled\\.[a-z][a-z0-9_]*$"},
            "input_contract": {"const": "SAME_FIXED_FULL_DAMAGE_RESULT"}
          }
        }]},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^compiled\\.[a-z][a-z0-9_]*$"}},
        "reads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(selector|accessor|fact):[A-Za-z][A-Za-z0-9_.:-]*$"}},
        "permitted_occurrence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"}}
      }
    }
  }
}
