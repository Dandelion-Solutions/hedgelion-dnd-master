{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/live-opening-seed.schema.json",
  "title": "HDM LIVE opening seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "preparation",
    "source",
    "native_owner_states",
    "provenance",
    "privacy",
    "chronology",
    "unresolved_work"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "runtime.live_opening_seed"},
    "preparation": {"$ref": "live-opening-preparation.schema.json"},
    "source": {"$ref": "live-routing.schema.json#/properties/entries/items"},
    "native_owner_states": {"type": "object"},
    "provenance": {"type": "object"},
    "privacy": {"type": "object"},
    "chronology": {"type": "object"},
    "unresolved_work": {"type": "object"}
  }
}
