    "ledger":{"type":"object","additionalProperties":false,"required":["source_key","source_memberships","coverage_id","package_presence","product_scope","realization","disposition","route_id","source_citations","negative_space"],"properties":{"source_key":{"type":"string","pattern":"^(PACKAGE|MACHINE|PRODUCT):"},"source_memberships":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["PACKAGE_CLOSURE_KEYS","ACTIVE_MACHINE_CONSUMER_KEYS","PRODUCT_PROMISE_KEYS"]}},"coverage_id":{"type":"string","pattern":"^coverage\\.[0-9a-f]{16}$"},"package_presence":{"enum":["PRESENT_ACTIVE_OR_TRANSITIVE","ABSENT"]},"product_scope":{"enum":["SUPPORTED","EXPLICITLY_OUT_OF_SCOPE"]},"realization":{"enum":["COMPLETE","NOT_APPLICABLE"]},"disposition":{"enum":["IN_SUPPORTED_MVP","OUT_OF_SUPPORTED_MVP_SEED"]},"route_id":{"type":"string","pattern":"^route\\."},"source_citations":{"$ref":"#/$defs/uniqueStrings"},"negative_space":{"type":"string","minLength":1}}},
