    "sourceManifest":{"type":"object","additionalProperties":false,"required":["PACKAGE_CLOSURE_KEYS","ACTIVE_MACHINE_CONSUMER_KEYS","PRODUCT_PROMISE_KEYS"],"properties":{"PACKAGE_CLOSURE_KEYS":{"$ref":"#/$defs/uniqueStrings"},"ACTIVE_MACHINE_CONSUMER_KEYS":{"$ref":"#/$defs/uniqueStrings"},"PRODUCT_PROMISE_KEYS":{"$ref":"#/$defs/uniqueStrings"}}},
