{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-message-state.schema.json",
  "title": "HDM runtime.message state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "interaction_id", "direction", "payload_state", "content_digest"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "input_basis_generation": {"type": "integer", "const": 1},
    "representation_kind": {"const": "accepted_text"},
    "message_id": {"$ref": "#/$defs/id"},
    "interaction_id": {"$ref": "#/$defs/id"},
    "direction": {"enum": ["inbound", "outbound"]},
    "recipient_player_id": {"$ref": "#/$defs/id"},
    "payload_state": {"enum": ["message.exact_retained", "message.compacted"]},
    "exact_text": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_domain_ref": {"$ref": "#/$defs/id"},
    "semantic_event_refs": {"$ref": "#/$defs/idSet"},
    "delivery_evidence_ref": {"$ref": "#/$defs/id"}
  },
  "allOf": [
    {"if": {"properties": {"payload_state": {"const": "message.exact_retained"}}, "required": ["payload_state"]}, "then": {"required": ["exact_text"]}, "else": {"not": {"required": ["exact_text"]}}},
    {"if": {"properties": {"direction": {"const": "inbound"}}, "required": ["direction"]}, "then": {"required": ["input_basis_generation", "representation_kind"], "not": {"anyOf": [{"required": ["recipient_player_id"]}, {"required": ["delivery_evidence_ref"]}]}}, "else": {"required": ["recipient_player_id"], "not": {"anyOf": [{"required": ["input_basis_generation"]}, {"required": ["representation_kind"]}]}}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
