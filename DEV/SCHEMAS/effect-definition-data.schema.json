{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/effect-definition-data.schema.json",
  "title": "HDM definition.effect data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "duration": {"$ref": "https://hedgelion.invalid/schemas/duration-spec.schema.json"},
    "parameter_schema": {"$ref": "#/$defs/parameterDeclarations"},
    "rule_elements": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/rule-element.schema.json"}
    },
    "trigger_bindings": {
      "type": "array",
      "items": {"$ref": "https://hedgelion.invalid/schemas/trigger-binding.schema.json"}
    },
    "scheduled_triggers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/localTriggerKey"},
      "additionalProperties": {"$ref": "#/$defs/scheduledTrigger"}
    },
    "activity_ids": {"$ref": "#/$defs/idSet"},
    "reapplication": {"$ref": "#/$defs/reapplication"},
    "arbitration_policy_id": {"$ref": "#/$defs/machineId"},
    "details": {"type": "object"}
  },
  "$defs": {
    "machineId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "localTriggerKey": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/machineId"}
    },
    "metricDelay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind_id", "amount", "unit_id"],
      "properties": {
        "kind_id": {"const": "duration.metric"},
        "amount": {"type": "integer", "minimum": 1},
        "unit_id": {"$ref": "#/$defs/machineId"}
      }
    },
    "scheduledTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["after", "activity_id"],
      "properties": {
        "after": {"$ref": "#/$defs/metricDelay"},
        "activity_id": {"$ref": "#/$defs/machineId"}
      }
    },
    "reapplication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["match_policy_id", "action_id"],
      "properties": {
        "match_policy_id": {
          "enum": [
            "effect_reapplication_match.target_family",
            "effect_reapplication_match.target_family_source"
          ]
        },
        "action_id": {
          "enum": [
            "effect_reapplication.refresh",
            "effect_reapplication.replace"
          ]
        }
      }
    },
    "parameterDeclarations": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/machineId"},
      "additionalProperties": {"$ref": "#/$defs/parameterDeclaration"}
    },
    "parameterDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type_id"],
      "properties": {
        "type_id": {"enum": ["integer", "number", "boolean", "machine_id", "string"]},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "allowed_ids": {"$ref": "#/$defs/idSet"}
      }
    }
  },
  "examples": [
    {
      "duration": {"kind_id": "duration.metric", "amount": 1, "unit_id": "unit.minute"},
      "rule_elements": [
        {"operation_id": "rule.add_flat", "selector": "defense.armor_class", "value": 2}
      ]
    },
    {
      "reapplication": {
        "match_policy_id": "effect_reapplication_match.target_family_source",
        "action_id": "effect_reapplication.refresh"
      }
    },
    {
      "scheduled_triggers": {
        "daily_save": {
          "after": {"kind_id": "duration.metric", "amount": 24, "unit_id": "unit.hour"},
          "activity_id": "srd.activity.disease_save"
        }
      }
    }
  ]
}
