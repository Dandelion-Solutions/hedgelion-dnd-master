{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/reaction-offer.schema.json",
  "title": "HDM value.reaction_offer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "offer_id",
    "parent_resolution_id",
    "continuation_generation",
    "responder_id",
    "candidate_activity_ids"
  ],
  "properties": {
    "kind": {
      "const": "reaction"
    },
    "offer_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_resolution_id": {
      "type": "string",
      "minLength": 1
    },
    "continuation_generation": {
      "type": "integer",
      "minimum": 1
    },
    "responder_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_activity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "examples": [
    {
      "kind": "reaction",
      "offer_id": "reaction-0001",
      "responder_id": "actor-0002",
      "candidate_activity_ids": [
        "activity.shield"
      ],
      "parent_resolution_id": "resolution-0001",
      "continuation_generation": 1
    }
  ]
}

