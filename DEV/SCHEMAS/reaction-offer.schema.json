{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/reaction-offer.schema.json",
  "title": "HDM value.reaction_offer",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "offer_id", "responder_id", "candidate_activity_ids"],
  "properties": {
    "kind": {"const": "reaction"},
    "offer_id": {"type": "string", "minLength": 1},
    "responder_id": {"type": "string", "minLength": 1},
    "candidate_activity_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "examples": [
    {
      "kind": "reaction",
      "offer_id": "reaction-0001",
      "responder_id": "actor-0002",
      "candidate_activity_ids": ["activity.shield"]
    }
  ]
}