{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/story-source-window.schema.json",
  "title": "HDM transient Story source-domain window",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_domain",
    "semantic_contract_generation",
    "source_basis",
    "expected_coverage",
    "proposed_coverage",
    "candidates"
  ],
  "properties": {
    "source_domain": {"type": "string", "minLength": 1},
    "semantic_contract_generation": {"type": "integer", "minimum": 1},
    "source_basis": {"$ref": "#/$defs/sourceBasis"},
    "expected_coverage": {"$ref": "#/$defs/terminalCoverage"},
    "proposed_coverage": {"$ref": "#/$defs/terminalCoverage"},
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "cursor": {"type": "string", "pattern": "^(msg|arc|evt|rel|seg|out):[1-9][0-9]*$"},
    "terminalCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "through"],
      "properties": {
        "kind": {"const": "CONTIGUOUS"},
        "through": {"oneOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]}
      }
    },
    "ownerContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family"],
      "properties": {
        "family": {"type": "string", "minLength": 1},
        "schema_version": {"type": "integer", "minimum": 1},
        "semantic_generation": {"type": "integer", "minimum": 1}
      },
      "anyOf": [
        {"required": ["schema_version"]},
        {"required": ["semantic_generation"]}
      ]
    },
    "sourceBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "lane",
        "upper",
        "enumeration_representation",
        "owner_contracts"
      ],
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "lane": {"enum": ["msg", "arc", "evt", "rel", "seg", "out"]},
        "upper": {"oneOf": [{"$ref": "#/$defs/cursor"}, {"type": "null"}]},
        "enumeration_representation": {"type": "string", "minLength": 1},
        "owner_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ownerContract"}
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "requirement", "source_keys"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["MUST_MATERIALIZE", "MAY_OMIT"]},
        "source_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"}
        }
      }
    }
  }
}
