{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/catalog-context-basis.schema.json",
  "title": "HDM exact reconstructive catalog-context basis",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_generation", "engine_version", "engine_contract_inventory_sha256", "engine_contract_inventory", "ruleset_lock", "campaign_definition_frontier", "natural_owner_evidence"],
  "properties": {
    "catalog_generation": {"const": 2},
    "engine_version": {"type": "string", "minLength": 1},
    "engine_contract_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "engine_contract_inventory": {"$ref": "#/$defs/engineContractInventory"},
    "ruleset_lock": {
      "allOf": [
        {"$ref": "resolved-ruleset-lock.schema.json"},
        {"properties": {"packages": {"items": {"properties": {"catalog_generation": {"const": 2}}}}}}
      ]
    },
    "campaign_definition_frontier": {"$ref": "#/$defs/frontier"},
    "session_overlay_frontier": {"$ref": "#/$defs/frontier"},
    "natural_owner_evidence": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/naturalOwnerEvidence"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frontier_id", "state_revision", "definition_ids"],
      "properties": {
        "frontier_id": {"$ref": "#/$defs/id"},
        "state_revision": {"type": "integer", "minimum": 0},
        "definition_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "engineContractInventory": {
      "type": "object", "additionalProperties": false,
      "required": ["inventory_schema_version", "engine_version", "ruleset_set_digest_generation", "ruleset_set_sha256", "items", "inventory_sha256"],
      "properties": {
        "inventory_schema_version": {"const": 2}, "engine_version": {"type": "string", "minLength": 1},
        "ruleset_set_digest_generation": {"const": 1}, "ruleset_set_sha256": {"$ref": "#/$defs/sha256"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inventoryItem"}}, "inventory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "inventoryItem": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "contract_id", "semantic_sha256"],
      "properties": {"family": {"type": "string", "minLength": 1}, "contract_id": {"type": "string", "minLength": 1}, "semantic_sha256": {"$ref": "#/$defs/sha256"}}
    },
    "naturalOwnerEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["definition_id", "kind", "owner_domain", "scope", "route", "pinned_revision", "content_sha256"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"}, "kind": {"$ref": "#/$defs/id"},
        "owner_domain": {"enum": ["campaign", "session"]}, "scope": {"enum": ["campaign.definition_frontier", "session.overlay_frontier"]},
        "route": {"type": "string", "minLength": 1}, "pinned_revision": {"type": "integer", "minimum": 0}, "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
