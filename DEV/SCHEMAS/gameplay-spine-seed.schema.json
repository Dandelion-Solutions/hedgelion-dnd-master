{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/gameplay-spine-seed.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_name", "schema_version", "profile_id", "package_id", "package_version", "catalog_generation", "activity_definitions", "procedure_profile", "spatial_profile", "transition_profiles", "downstream_consequence_profiles", "unsupported_policy"],
  "properties": {
    "schema_name": {"const": "hdm_gameplay_spine_seed"}, "schema_version": {"const": 1},
    "profile_id": {"const": "gameplay_spine.mvp.v1"}, "package_id": {"const": "hdm.rules.dnd2024-srd52-core"},
    "package_version": {"const": "0.1.0-mvp"}, "catalog_generation": {"const": "2.0.0"},
    "activity_definitions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/activity"}},
    "procedure_profile": {"$ref": "#/$defs/procedure"}, "spatial_profile": {"$ref": "#/$defs/spatial"},
    "transition_profiles": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/transition"}},
    "downstream_consequence_profiles": {"const": ["NONE", "EXACT_DAMAGE", "EXACT_LOCATION_CHANGE", "EXACT_ASSET_TRANSFER"]},
    "unsupported_policy": {"const": "ABSENT_NONSELECTABLE"}
  },
  "$defs": {
    "activity": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "data"],
      "properties": {
        "id": {"enum": ["activity.check.generic", "activity.save.generic"]}, "kind": {"const": "definition.activity"},
        "data": {"$ref": "https://hedgelion.invalid/schemas/activity-definition-data.schema.json"}
      }
    },
    "procedure": {
      "type": "object", "additionalProperties": false,
      "required": ["procedure_kind", "state_schema", "request_schema", "result_schema", "event_schema", "event_kind", "resource_ids", "transitions", "transition_profiles", "initiative_retry", "encounter_authority"],
      "properties": {
        "procedure_kind": {"const": "procedure.combat_minimal"}, "state_schema": {"const": "DEV/SCHEMAS/combat-minimal-procedure-state.schema.json"},
        "request_schema": {"const": "DEV/SCHEMAS/combat-procedure-transition-request.schema.json"},
        "result_schema": {"const": "DEV/SCHEMAS/combat-procedure-transition-result.schema.json"},
        "event_schema": {"const": "DEV/SCHEMAS/procedure-state-changed-event.schema.json"},
        "event_kind": {"const": "event.procedure.state_changed"},
        "resource_ids": {"const": ["resource.action_budget", "resource.movement_budget"]},
        "transitions": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["initialize", "start_turn", "spend_action", "spend_movement", "end_turn", "advance_round", "terminate"]}},
        "transition_profiles": {"const": {"initialize": "procedure.initialize", "start_turn": "procedure.start_turn", "spend_action": "procedure.spend_action", "spend_movement": "procedure.spend_movement", "end_turn": "procedure.end_turn", "advance_round": "procedure.advance_round", "terminate": "procedure.terminate"}},
        "initiative_retry": {"const": "REUSE_FIXED_ORDER_AND_TIE_RESOLUTION"}, "encounter_authority": {"const": "REFERENCE_ONLY"}
      }
    },
    "spatial": {
      "type": "object", "additionalProperties": false, "required": ["input_class", "allowed_refs", "adjudicated_fact_ids", "within_location_reposition", "forbidden_capabilities"],
      "properties": {
        "input_class": {"const": "ENGINE_BOUND_OR_INVOCATION_ADJUDICATED"},
        "allowed_refs": {"const": ["world.actor.state.location_id", "world.location.id", "value.target_spec", "value.area_spec"]},
        "adjudicated_fact_ids": {"const": ["fiction.target_reachable"]},
        "within_location_reposition": {"const": "FICTIONAL_POSITION_PLUS_PROCEDURE_BUDGET; NO_WORLD_LOCATION_MUTATION"},
        "forbidden_capabilities": {"const": ["PATHFINDING", "GLOBAL_GEOMETRY_QUERY", "UNIVERSAL_COORDINATES", "CAMPAIGN_SCAN"]}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_id", "transition_kind", "request_schema", "result_schema", "mutation_owners", "mutable_fields", "required_revisions", "atomicity", "partial_commit", "event_kinds", "failure_codes"],
      "properties": {
        "profile_id": {"enum": ["location_change.procedure_movement", "location_change.outside_procedure", "asset.transfer", "asset.equip", "asset.use"]},
        "transition_kind": {"enum": ["transition.location_change", "transition.asset_transfer", "transition.asset_status", "NO_TRANSITION_ACTIVITY_BINDING"]},
        "request_schema": {"type": "string", "pattern": "^DEV/SCHEMAS/gameplay-spine-transition-request\\.schema\\.json#/.+$"},
        "result_schema": {"type": "string", "pattern": "^DEV/SCHEMAS/gameplay-spine-transition-result\\.schema\\.json#/.+$"},
        "mutation_owners": {"type": "array", "uniqueItems": true, "items": {"enum": ["runtime.procedure", "world.actor", "world.asset"]}},
        "mutable_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_revisions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["procedure_revision", "actor_revision", "destination_location_revision", "asset_revision"]}},
        "atomicity": {"const": "ONE_EXECUTION_SEGMENT"}, "partial_commit": {"const": "FORBIDDEN"},
        "event_kinds": {"type": "array", "uniqueItems": true, "items": {"enum": ["event.entity.moved", "event.asset.transferred", "event.asset.status_changed"]}},
        "failure_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["failure.idempotency_conflict", "failure.state_revision_conflict", "failure.action_economy_scope_invalid", "failure.hydration_required", "failure.missing_reference", "failure.catalog_context_incompatible", "failure.transition_requires_procedure", "failure.execution_limit"]}}
      }
    }
  }
}

