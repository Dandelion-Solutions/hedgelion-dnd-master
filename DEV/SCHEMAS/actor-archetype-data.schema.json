{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/actor-archetype-data.schema.json",
  "title": "HDM definition.actor_archetype data",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "creature_type_id": {"$ref": "#/$defs/id"},
    "size_id": {"$ref": "#/$defs/id"},
    "abilities": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "hp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum"],
      "properties": {"maximum": {"type": "integer", "minimum": 0}}
    },
    "resources": {"type": "object"},
    "activity_ids": {"$ref": "#/$defs/idSet"},
    "feature_ids": {"$ref": "#/$defs/idSet"},
    "life_state_policy_id": {"$ref": "#/$defs/lifePolicyId"},
    "details": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "lifePolicyId": {
      "enum": ["life_policy.dnd2024.character_like", "life_policy.dnd2024.monster_default"]
    },
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    }
  }
}
