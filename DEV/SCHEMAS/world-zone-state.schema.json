{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/world-zone-state.schema.json",
  "title": "HDM world.zone state",
  "type": "object",
  "additionalProperties": false,
  "required": ["location_id", "name"],
  "properties": {
    "location_id": {"$ref": "#/$defs/id"},
    "name": {"type": "string", "minLength": 1},
    "participant_ids": {"$ref": "#/$defs/idSet"},
    "effect_ids": {"$ref": "#/$defs/idSet"},
    "geometry": {"$ref":"https://hedgelion.invalid/schemas/spell-native-profile-values.schema.json#/$defs/geometry"},
    "participation_state": {"$ref":"https://hedgelion.invalid/schemas/spell-native-profile-values.schema.json#/$defs/participationState"},
    "status": {"type": "object"},
    "details": {"$ref":"https://hedgelion.invalid/schemas/spell-native-profile-values.schema.json#/$defs/nonExecutableDetails"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}
