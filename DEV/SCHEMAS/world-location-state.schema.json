{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/world-location-state.schema.json",
  "title": "HDM world.location state",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "parent_location_id": {"$ref": "#/$defs/id"},
    "organization_id": {"$ref": "#/$defs/id"},
    "environment_ids": {"$ref": "#/$defs/idSet"},
    "status": {"type": "object"},
    "spell_place": {"$ref":"https://hedgelion.invalid/schemas/spell-native-profile-values.schema.json#/$defs/spellPlace"},
    "spell_progress": {"$ref":"https://hedgelion.invalid/schemas/spell-native-profile-values.schema.json#/$defs/progressMap"},
    "details": {"$ref":"https://hedgelion.invalid/schemas/spell-native-profile-values.schema.json#/$defs/nonExecutableDetails"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "idSet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  }
}

