{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/runtime-collaboration-obligation-state.schema.json",
  "title": "HDM runtime.collaboration_obligation state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "obligation_id",
    "generation",
    "lifecycle",
    "coordination_family",
    "campaign_id",
    "purpose",
    "dependency_scope",
    "decision_opportunity_ref",
    "currentness_basis",
    "required_contributors",
    "optional_contributors",
    "accepted_input_uses",
    "safe_frontier_refs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "runtime.collaboration_obligation"},
    "obligation_id": {"$ref": "#/$defs/id"},
    "generation": {"type": "integer", "minimum": 1},
    "lifecycle": {"enum": ["OPEN", "CLOSED", "RESOLVED", "OBSOLETE"]},
    "coordination_family": {"const": "AGENCY_DEPENDENT_COLLECTIVE"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "purpose": {"type": "string", "minLength": 1},
    "dependency_scope": {"type": "string", "minLength": 1},
    "decision_opportunity_ref": {"type": "string", "minLength": 1},
    "currentness_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_revision", "opportunity_ref"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_revision": {"$ref": "#/$defs/revision"},
        "opportunity_ref": {"type": "string", "minLength": 1}
      }
    },
    "required_contributors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/participant"}
    },
    "optional_contributors": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/participant"}
    },
    "accepted_input_uses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["interaction_id", "clause_id"],
        "properties": {
          "interaction_id": {"$ref": "#/$defs/id"},
          "clause_id": {"$ref": "#/$defs/id"}
        }
      }
    },
    "safe_frontier_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "execution_anchor_clause_ref": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["interaction_id", "clause_id"],
          "properties": {
            "interaction_id": {"$ref": "#/$defs/id"},
            "clause_id": {"$ref": "#/$defs/id"}
          }
        }
      ]
    },
    "closed_input_set_fingerprint": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "revision": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}(?:[a-f0-9]{24})?|[A-Za-z][A-Za-z0-9_.:-]*)$"
    },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["player_id"],
      "properties": {
        "player_id": {"$ref": "#/$defs/id"},
        "pc_id": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/id"}
          ]
        }
      }
    }
  },
  "examples": [
    {
      "schema_version": 1,
      "kind": "runtime.collaboration_obligation",
      "obligation_id": "obligation-1",
      "generation": 1,
      "lifecycle": "OPEN",
      "coordination_family": "AGENCY_DEPENDENT_COLLECTIVE",
      "campaign_id": "campaign-frostfall",
      "purpose": "joint-entry",
      "dependency_scope": "scene:market",
      "decision_opportunity_ref": "decision:market-entry",
      "currentness_basis": {
        "source_ref": "scene:market",
        "source_revision": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "opportunity_ref": "decision:market-entry"
      },
      "required_contributors": [{"player_id": "player-alice", "pc_id": "pc-alice"}],
      "optional_contributors": [],
      "accepted_input_uses": [],
      "safe_frontier_refs": []
    }
  ]
}
