    {
      "id": "activity.feature.tactical_mind",
      "kind": "definition.activity",
      "data": {
        "family_id": "activity.check_modifier",
        "details": {"invocation_gate": "PRIOR_ABILITY_CHECK_FAILED", "request_binding": "D10_WITH_PRIOR_CHECK_TOTAL_AS_FIXED_MODIFIER", "consume_policy": "ONLY_IF_AUGMENTED_RESULT_SUCCEEDS", "failed_augmented_result": "NO_RESOURCE_CONSUMPTION_AND_ORIGINAL_FAILURE_STANDS"},
        "steps": [
          {
            "op": "op.roll",
            "args": {
              "request": "compiled.d10_plus_prior_check_total"
            },
            "export": "augmented_roll"
          },
          {
            "op": "op.resolve_check",
            "args": {
              "roll": "augmented_roll.result",
              "threshold": "invocation.prior_check_dc"
            },
            "export": "augmented_check"
          },
          {
            "op": "op.consume_resource",
            "args": {"owner_role": "actor", "resource_ref": "resource.second_wind", "amount": 1},
            "when": {"result": "augmented_check.outcome", "in": ["success"]}
          }
        ]
      }
    },
