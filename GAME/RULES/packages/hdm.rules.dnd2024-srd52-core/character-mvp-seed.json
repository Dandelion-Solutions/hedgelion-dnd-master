      "kind": "definition.activity",
      "data": {
        "family_id": "activity.spell_save",
        "steps": [
          {"op": "op.select_targets", "args": {"target_spec": "compiled.target"}, "export": "targets"},
          {"op": "op.roll", "args": {"request": "compiled.constitution_save"}, "export": "save_roll"},
          {"op": "op.resolve_save", "args": {"roll": "save_roll.result", "threshold": "selector.spell.dc"}, "export": "save"},
          {"op": "op.apply_damage", "args": {"target_role": "target", "components": "compiled.poison_damage"}, "when": {"result": "save.outcome", "in": ["failure"]}}
        ]
      }
    },
    {
      "id": "activity.spell.thunderclap",
      "kind": "definition.activity",
      "data": {
        "family_id": "activity.spell_save",
        "details": {"target_iteration": "ORDERED_BOUNDED_PER_TARGET", "save_damage_policy": "NONE_ON_SUCCESS"},
        "steps": [
          {"op": "op.select_targets", "args": {"target_spec": "compiled.emanation_targets"}, "export": "targets"},
          {"op": "op.for_each_target", "args": {"targets": "targets", "steps": [
            {"op": "op.roll", "args": {"request": "compiled.constitution_save:$target"}, "export": "save_roll"},
            {"op": "op.resolve_save", "args": {"roll": "save_roll.result", "threshold": "selector.spell.dc"}, "export": "save"},
            {"op": "op.apply_damage", "args": {"target_role": "$target", "components": "compiled.thunder_damage"}, "when": {"result": "save.outcome", "in": ["failure"]}}
