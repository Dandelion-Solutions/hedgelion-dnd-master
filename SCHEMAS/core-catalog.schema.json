{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/core-catalog.schema.json",
  "title": "HDM engine capability catalog seed",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalog_version", "schema_version", "registries"],
  "properties": {
    "catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_version": {
      "const": 1
    },
    "registries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_kinds",
        "asset_facets",
        "activity_families",
        "activity_primitives",
        "transition_kinds",
        "event_kinds",
        "resource_kinds",
        "effect_facets",
        "rule_operations",
        "mapping_outcomes",
        "durability_classes",
        "knowledge_modes",
        "duration_units"
      ],
      "properties": {
        "entity_kinds": {"$ref": "#/$defs/idRegistry"},
        "asset_facets": {"$ref": "#/$defs/idRegistry"},
        "activity_families": {"$ref": "#/$defs/idRegistry"},
        "activity_primitives": {"$ref": "#/$defs/idRegistry"},
        "transition_kinds": {"$ref": "#/$defs/idRegistry"},
        "event_kinds": {"$ref": "#/$defs/idRegistry"},
        "resource_kinds": {"$ref": "#/$defs/idRegistry"},
        "effect_facets": {"$ref": "#/$defs/idRegistry"},
        "rule_operations": {"$ref": "#/$defs/idRegistry"},
        "mapping_outcomes": {"$ref": "#/$defs/idRegistry"},
        "durability_classes": {"$ref": "#/$defs/idRegistry"},
        "knowledge_modes": {"$ref": "#/$defs/idRegistry"},
        "duration_units": {"$ref": "#/$defs/idRegistry"}
      }
    }
  },
  "$defs": {
    "idRegistry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$"
      }
    }
  }
}
