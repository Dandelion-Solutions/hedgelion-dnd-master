{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/world-record.schema.json",
  "title": "HDM world-record envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "state"],
  "properties": {
    "id": {"$ref": "#/$defs/machineId"},
    "kind": {
      "type": "string",
      "pattern": "^world\\.[a-z][a-z0-9_]*$"
    },
    "definition_id": {"$ref": "#/$defs/machineId"},
    "state": {"type": "object"}
  },
  "$defs": {
    "machineId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    }
  }
}
