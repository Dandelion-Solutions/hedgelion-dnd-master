{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hedgelion.invalid/schemas/catalog-definition.schema.json",
  "title": "HDM reusable catalog definition envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "data"],
  "properties": {
    "id": {
      "allOf": [{"$ref": "#/$defs/machineId"}],
      "description": "Stable semantic namespaced ID; reusable definitions do not use numeric allocation."
    },
    "kind": {
      "type": "string",
      "pattern": "^definition\\.[a-z][a-z0-9_]*$"
    },
    "name": {"$ref": "#/$defs/localizedText"},
    "facets": {"$ref": "#/$defs/idSet"},
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "data": {"type": "object"}
  },
  "$defs": {
    "machineId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/machineId"}
    },
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "required": ["en"],
      "propertyNames": {
        "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
